<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:focusable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:descendantFocusability="afterDescendants"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.zhy.autolayout.AutoRelativeLayout
        android:id="@+id/broader"
        android:background="@drawable/sel_poster_nohalo"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:descendantFocusability="blocksDescendants"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/ivProPoster"
            android:layout_width="225px"
            android:layout_height="330px"
            android:scaleType="fitXY"
            android:transitionName="poster"/>
        <TextView
            android:textSize="22px"
            android:textColor="@color/color_f5f5f5"
            android:ellipsize="marquee"
            android:gravity="bottom|right"
            android:id="@+id/tvUpdateNum"
            android:background="@drawable/shape_vod_serial_state_bg"
            android:paddingLeft="5px"
            android:paddingRight="5px"
            android:paddingBottom="5px"
            android:visibility="gone"
            android:layout_width="225px"
            android:layout_height="100px"
            android:layout_marginBottom="1dp"
            android:singleLine="true"
            android:layout_alignParentBottom="true"/>
        <ProgressBar
            android:id="@+id/mWatchProgress"
            android:paddingBottom="4px"
            android:visibility="gone"
            android:layout_width="200px"
            android:layout_height="10px"
            android:layout_marginLeft="10px"
            android:layout_marginRight="10px"
            android:progressDrawable="@drawable/bg_history_progressbar"
            android:layout_alignParentBottom="true"
            style="?android:attr/progressBarStyleHorizontal"/>
        <TextView
            android:textColor="@color/color_ffffff"
            android:gravity="center"
            android:id="@+id/mTvIndex"
            android:background="@color/color_99000000"
            android:visibility="gone"
            android:layout_width="100px"
            android:layout_height="42px"/>
        <ImageView
            android:id="@+id/video_new_tag"
            android:background="@mipmap/vod_icon_tag_new"
            android:visibility="gone"
            android:layout_width="58px"
            android:layout_height="28px"/>
        <ImageView
            android:id="@+id/tvTsTag"
            android:background="@mipmap/vod_icon_tag_ts"
            android:visibility="gone"
            android:layout_width="51px"
            android:layout_height="52px"
            android:layout_alignParentRight="true"/>
        <ImageView
            android:id="@+id/mImg4kTag"
            android:background="@mipmap/vod_icon_tag_4k"
            android:visibility="gone"
            android:layout_width="58px"
            android:layout_height="36px"
            android:layout_alignParentRight="true"/>
        <ImageView
            android:id="@+id/tvTopicTag"
            android:background="@mipmap/vod_icon_tag_special"
            android:visibility="gone"
            android:layout_width="90px"
            android:layout_height="90px"
            android:layout_marginTop="-6px"
            android:layout_marginRight="-7px"
            android:layout_alignParentRight="true"/>
        <ImageView
            android:id="@+id/tvTagSubtitle"
            android:background="@mipmap/vod_icon_tag_subtitle"
            android:visibility="gone"
            android:layout_width="38px"
            android:layout_height="28px"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"/>
        <TextView
            android:textSize="24px"
            android:textStyle="bold"
            android:textColor="@color/color_ff8300"
            android:gravity="center"
            android:id="@+id/tvdDtailsSroce"
            android:background="@mipmap/vod_icon_tag_score_bg"
            android:visibility="gone"
            android:layout_width="48px"
            android:layout_height="28px"
            android:includeFontPadding="false"
            android:layout_alignParentBottom="true"/>
        <com.zhy.autolayout.AutoRelativeLayout
            android:id="@+id/rlCancel"
            android:background="@color/color_82000000"
            android:visibility="gone"
            android:layout_width="225px"
            android:layout_height="330px">
            <ImageView
                android:id="@+id/rl_item_img_cancel"
                android:layout_width="80px"
                android:layout_height="80px"
                android:src="@mipmap/item_fav_gridview_collect_cancel_icon"
                android:layout_centerInParent="true"/>
        </com.zhy.autolayout.AutoRelativeLayout>
        <com.zhy.autolayout.AutoRelativeLayout
            android:id="@+id/mIvPlayBack"
            android:background="@color/color_99000000"
            android:visibility="visible"
            android:layout_width="225px"
            android:layout_height="330px">
            <ImageView
                android:id="@+id/mIvPlay"
                android:background="@mipmap/ic_home_history_play"
                android:layout_width="72px"
                android:layout_height="72px"
                android:layout_centerInParent="true"/>
        </com.zhy.autolayout.AutoRelativeLayout>
    </com.zhy.autolayout.AutoRelativeLayout>
    <TextView
        android:textSize="32px"
        android:textColor="@color/color_font_second"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tvVideoName"
        android:paddingTop="12px"
        android:paddingBottom="22px"
        android:visibility="visible"
        android:layout_width="215px"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5px"
        android:layout_marginRight="5px"
        android:layout_below="@+id/broader"
        style="@style/marqueeText"/>
</com.zhy.autolayout.AutoRelativeLayout>
