<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:focusable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.zhy.autolayout.AutoRelativeLayout
        android:id="@+id/mPosterLayout"
        android:background="@drawable/sel_poster_nohalo"
        android:duplicateParentState="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="224px"
        android:layout_height="329px">
        <ImageView
            android:id="@+id/mPosterImg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"/>
        <TextView
            android:textColor="@color/color_ffffff"
            android:gravity="center"
            android:id="@+id/mTvIndex"
            android:background="@color/color_99000000"
            android:visibility="gone"
            android:layout_width="100px"
            android:layout_height="42px"/>
        <ImageView
            android:id="@+id/mBackground"
            android:background="@color/color_99000000"
            android:layout_width="224px"
            android:layout_height="329px"
            android:layout_alignParentBottom="true"/>
        <ImageView
            android:id="@+id/mIvPlay"
            android:background="@mipmap/ic_home_history_play"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"/>
        <ProgressBar
            android:id="@+id/progress_bar"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="8px"
            android:layout_marginLeft="10px"
            android:layout_marginRight="10px"
            android:layout_marginBottom="4px"
            android:progressDrawable="@drawable/bg_history_progressbar"
            android:layout_alignParentBottom="true"
            android:elevation="4px"
            style="?android:attr/progressBarStyleHorizontal"/>
        <ImageView
            android:id="@+id/mImg4kTag"
            android:background="@mipmap/vod_icon_tag_4k"
            android:visibility="gone"
            android:layout_width="58px"
            android:layout_height="36px"
            android:layout_alignParentRight="true"/>
        <com.zhy.autolayout.AutoRelativeLayout
            android:id="@+id/mLayoutMore"
            android:background="@drawable/personal_history_more_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:id="@+id/mRankingImg"
            android:layout_width="61px"
            android:layout_height="61px"
            android:scaleType="fitStart"/>
        <TextView
            android:textSize="30px"
            android:textColor="@color/color_ffffffff"
            android:gravity="center"
            android:id="@+id/mRankingText"
            android:paddingRight="5px"
            android:layout_width="56px"
            android:layout_height="45px"
            android:layout_marginTop="-5px"
            android:lineSpacingExtra="0px"/>
    </com.zhy.autolayout.AutoRelativeLayout>
    <TextView
        android:textSize="32px"
        android:textColor="@color/color_font_normal"
        android:gravity="center"
        android:id="@+id/mVideoNameText"
        android:paddingTop="10px"
        android:paddingBottom="20px"
        android:visibility="visible"
        android:duplicateParentState="true"
        android:layout_width="224px"
        android:layout_height="wrap_content"
        android:layout_below="@+id/mPosterLayout"
        android:layout_centerHorizontal="true"
        style="@style/marqueeText"/>
</com.zhy.autolayout.AutoRelativeLayout>
