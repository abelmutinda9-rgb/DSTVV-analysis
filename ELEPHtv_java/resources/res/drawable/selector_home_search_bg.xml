<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_focused="true"
        android:height="40dp"
        android:width="133dp">
        <layer-list>
            <item>
                <nine-patch android:src="@drawable/focus_navigation"/>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="20dp"/>
                    <solid android:color="@color/color_b33d424d"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item
        android:state_focused="false"
        android:height="40dp"
        android:width="133dp"
        android:state_hovered="true">
        <layer-list>
            <item android:drawable="@drawable/focus_navigation"/>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="20dp"/>
                    <solid android:color="@color/color_b33d424d"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item
        android:height="40dp"
        android:width="133dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp"/>
            <solid android:color="@color/color_b33d424d"/>
        </shape>
    </item>
</selector>
