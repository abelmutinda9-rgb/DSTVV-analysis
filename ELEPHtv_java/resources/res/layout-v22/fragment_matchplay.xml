<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/flContainer"
    android:background="@color/color_000000"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/mIvFreeTrialPeriod"
        android:visibility="gone"
        android:layout_width="155px"
        android:layout_height="155px"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/color_ffffff"
        android:id="@+id/mTvDataInfo"
        android:background="#80000000"
        android:paddingLeft="27dp"
        android:paddingTop="17dp"
        android:paddingRight="13dp"
        android:paddingBottom="13dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="480dp"/>
    <com.match.view.MatchPlayerController
        android:id="@+id/mPlayerController"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <TextView
        android:textSize="28px"
        android:textColor="@color/color_ffffff"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/mTvStatus"
        android:paddingLeft="60px"
        android:paddingRight="60px"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/match_hint_content_unavailable"/>
    <RelativeLayout
        android:layout_gravity="center"
        android:id="@+id/mLayoutError"
        android:background="@drawable/bg_dialog"
        android:visibility="gone"
        android:layout_width="541dp"
        android:layout_height="208dp">
        <ImageView
            android:id="@+id/mImgWaring"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginLeft="27dp"
            android:layout_marginTop="27dp"
            android:src="@mipmap/icon_error"/>
        <TextView
            android:textSize="21sp"
            android:textColor="@android:color/white"
            android:gravity="left"
            android:id="@+id/mTextError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="27dp"
            android:layout_marginRight="40dp"
            android:layout_toRightOf="@+id/mImgWaring"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_8c9194"
            android:id="@+id/mTextVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="27dp"
            android:layout_marginBottom="13dp"
            android:layout_alignParentBottom="true"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_8c9194"
            android:id="@+id/mTextAccount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="27dp"
            android:layout_marginBottom="13dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <com.zhy.autolayout.AutoLinearLayout
        android:layout_gravity="right"
        android:id="@+id/mFullTips"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60px"
        android:layout_marginRight="285px">
        <TextView
            android:textSize="36px"
            android:textColor="@color/color_ffffff"
            android:layout_gravity="center_vertical"
            android:id="@+id/mTvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="40px"/>
        <com.zhy.autolayout.AutoLinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/mLlNetStatus"
            android:background="@drawable/bg_net_speed"
            android:padding="11px"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="37px">
            <ImageView
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/mImageLoadStatue"
                android:layout_width="36px"
                android:layout_height="26px"
                android:src="@mipmap/icon_live_source_flag"/>
            <com.module.view.net.NetSpeedTextView
                android:textSize="28px"
                android:textColor="@color/color_ffffff"
                android:id="@+id/mTvDownSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10px"/>
        </com.zhy.autolayout.AutoLinearLayout>
    </com.zhy.autolayout.AutoLinearLayout>
    <com.zhy.autolayout.AutoRelativeLayout
        android:layout_gravity="bottom"
        android:id="@+id/rlChannelContainer"
        android:background="@drawable/shape_bg_switch_channel"
        android:visibility="gone"
        android:descendantFocusability="afterDescendants"
        android:layout_width="match_parent"
        android:layout_height="542px">
        <TextView
            android:textSize="34px"
            android:textColor="@color/color_ffffff"
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="205px"
            android:text="@string/match_switch_channel_infobar_title"
            android:layout_alignParentTop="true"
            android:layout_marginStart="68px"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="24px"
            android:textColor="@color/color_ffffff"
            android:id="@+id/tvTips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="211px"
            android:text="@string/match_switch_channel_infobar_tips"
            android:layout_alignParentTop="true"
            android:layout_marginEnd="67px"
            android:layout_alignParentEnd="true"/>
        <com.open.leanback.widget.HorizontalGridView
            android:id="@+id/mGridChannel"
            android:paddingLeft="132px"
            android:paddingRight="132px"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="176px"
            android:layout_marginTop="40px"
            android:horizontalSpacing="60px"
            android:layout_below="@+id/tvTitle"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"
            android:paddingHorizontal="132px"/>
    </com.zhy.autolayout.AutoRelativeLayout>
</com.zhy.autolayout.AutoFrameLayout>
