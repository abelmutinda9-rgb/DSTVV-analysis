<?xml version="1.0" encoding="utf-8"?>
<com.common.utils.mark.live.LiveRootView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mLiveRoot"
    android:background="@color/color_000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/mPlayFrameLayout"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.zhy.autolayout.AutoFrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/mIvFreeTrialPeriod"
            android:visibility="gone"
            android:layout_width="155px"
            android:layout_height="155px"/>
    </com.zhy.autolayout.AutoFrameLayout>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/color_ffffff"
        android:id="@+id/mTvDataInfo"
        android:background="#80000000"
        android:paddingLeft="27dp"
        android:paddingTop="17dp"
        android:paddingRight="13dp"
        android:paddingBottom="13dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="480dp"/>
    <com.live.view.player.LivePlayerController
        android:id="@+id/mPlayerController"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:layout_gravity="center"
        android:id="@+id/mLayoutError"
        android:background="@drawable/bg_dialog"
        android:visibility="gone"
        android:layout_width="541dp"
        android:layout_height="208dp">
        <ImageView
            android:id="@+id/mImgWaring"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginLeft="27dp"
            android:layout_marginTop="27dp"
            android:src="@mipmap/icon_error"/>
        <TextView
            android:textSize="21sp"
            android:textColor="@android:color/white"
            android:gravity="left"
            android:id="@+id/mTextError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="27dp"
            android:layout_marginRight="40dp"
            android:layout_toRightOf="@+id/mImgWaring"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_8c9194"
            android:id="@+id/mTextVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="27dp"
            android:layout_marginBottom="13dp"
            android:layout_alignParentBottom="true"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_8c9194"
            android:id="@+id/mTextAccount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="27dp"
            android:layout_marginBottom="13dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <FrameLayout
        android:layout_gravity="bottom|right"
        android:id="@+id/mFlPip"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:visibility="gone"
        android:layout_width="400dp"
        android:layout_height="225dp"
        android:layout_marginRight="67dp"
        android:layout_marginBottom="67dp"/>
    <FrameLayout
        android:id="@+id/mFlContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_ffffff"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tvChannelTips"
        android:background="@drawable/bg_show_all_channel"
        android:paddingLeft="20dp"
        android:paddingTop="16.5dp"
        android:paddingRight="20dp"
        android:paddingBottom="16.5dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/live_open_channel_tips"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16.5dp"/>
    <LinearLayout
        android:layout_gravity="right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_marginRight="67dp">
        <TextView
            android:textSize="24sp"
            android:textColor="@color/color_ffffff"
            android:layout_gravity="center_vertical"
            android:id="@+id/mTvTime"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="27dp"
            android:text="8:30"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/mLlNetStatus"
            android:background="@drawable/bg_net_speed"
            android:padding="7dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="25dp">
            <ImageView
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/mImageLoadStatue"
                android:layout_width="24dp"
                android:layout_height="17dp"
                android:src="@mipmap/icon_live_source_flag"/>
            <com.module.view.net.NetSpeedTextView
                android:textSize="19sp"
                android:textColor="@color/color_ffffff"
                android:id="@+id/mTvDownSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="7dp"
                android:text="719KB/s"/>
        </LinearLayout>
    </LinearLayout>
</com.common.utils.mark.live.LiveRootView>
