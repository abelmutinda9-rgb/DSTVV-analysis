<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.zhy.autolayout.AutoRelativeLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/bg_dialog_brasiliptv_new"
        android:layout_width="1458px"
        android:layout_height="953px">
        <TextView
            android:textSize="32px"
            android:textColor="@color/color_ffffff"
            android:gravity="center"
            android:id="@+id/tvTips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="100px"
            android:layout_marginTop="54px"
            android:layout_marginRight="100px"
            android:text="@string/device_limit_reached"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"
            android:layout_marginHorizontal="100px"/>
        <TextView
            android:textSize="24px"
            android:textColor="@color/color_807f84"
            android:gravity="center"
            android:id="@+id/tvContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="100px"
            android:layout_marginTop="35px"
            android:layout_marginRight="100px"
            android:text="@string/device_limit_reached_tips"
            android:lines="2"
            android:layout_below="@+id/tvTips"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"
            android:layout_marginHorizontal="100px"/>
        <com.zhy.autolayout.AutoFrameLayout
            android:layout_width="match_parent"
            android:layout_height="554px"
            android:layout_marginTop="28px"
            android:layout_below="@+id/tvContent">
            <com.open.leanback.widget.VerticalGridView
                android:layout_gravity="center_vertical"
                android:id="@+id/mGridDevice"
                android:paddingLeft="216px"
                android:paddingRight="216px"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:horizontalSpacing="32px"
                android:verticalSpacing="36px"
                android:layout_alignParentStart="true"
                android:layout_alignParentEnd="true"
                android:paddingHorizontal="216px"
                app:focusOutEnd="true"
                app:numberOfColumns="2"/>
        </com.zhy.autolayout.AutoFrameLayout>
        <com.zhy.autolayout.AutoLinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="68px"
            android:layout_alignParentBottom="true">
            <Button
                android:textSize="36px"
                android:textColor="@color/color_ffffff"
                android:gravity="center"
                android:id="@+id/btnSelectAll"
                android:background="@drawable/sel_device_limit_button_bg"
                android:layout_width="340px"
                android:layout_height="80px"
                android:text="@string/device_limit_reached_select_all"/>
            <Button
                android:textSize="36px"
                android:textColor="@drawable/sel_device_limit_button_text_color"
                android:gravity="center"
                android:id="@+id/btnDelete"
                android:background="@drawable/sel_device_limit_button_bg"
                android:layout_width="340px"
                android:layout_height="80px"
                android:layout_marginLeft="311px"
                android:text="@string/device_limit_reached_remove"/>
        </com.zhy.autolayout.AutoLinearLayout>
        <com.module.view.LoadingView
            android:id="@+id/loadingView"
            android:visibility="gone"
            android:layout_width="200px"
            android:layout_height="200px"
            android:layout_centerInParent="true"/>
    </com.zhy.autolayout.AutoRelativeLayout>
</com.zhy.autolayout.AutoLinearLayout>
