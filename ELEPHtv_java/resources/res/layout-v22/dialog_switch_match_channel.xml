<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.zhy.autolayout.AutoRelativeLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/bg_dialog_brasiliptv_new"
        android:layout_width="1095px"
        android:layout_height="800px">
        <TextView
            android:textSize="42px"
            android:textColor="@color/color_ffffff"
            android:gravity="center"
            android:id="@+id/tvTips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="100px"
            android:layout_marginTop="42px"
            android:layout_marginRight="100px"
            android:text="@string/match_switch_channel_infobar_title"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"
            android:layout_marginHorizontal="100px"/>
        <TextView
            android:textSize="26px"
            android:textColor="@color/color_878787"
            android:gravity="center"
            android:id="@+id/tvContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="100px"
            android:layout_marginTop="35px"
            android:layout_marginRight="100px"
            android:text="@string/match_switch_channel_dialog_tips"
            android:lines="2"
            android:layout_below="@+id/tvTips"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"
            android:layout_marginHorizontal="100px"/>
        <com.open.leanback.widget.VerticalGridView
            android:id="@+id/mGridChannel"
            android:paddingLeft="76px"
            android:paddingRight="76px"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="30px"
            android:layout_marginBottom="81px"
            android:verticalSpacing="10px"
            android:layout_below="@+id/tvContent"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"
            android:paddingHorizontal="76px"
            app:focusOutEnd="true"/>
    </com.zhy.autolayout.AutoRelativeLayout>
</com.zhy.autolayout.AutoLinearLayout>
