<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mRootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zhy.autolayout.AutoLinearLayout
        android:orientation="vertical"
        android:id="@+id/mTextNotPerson"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="113px"
            android:layout_height="135px"
            android:src="@mipmap/ic_no_person_placeholder"
            android:scaleType="fitXY"/>
        <TextView
            android:textSize="40px"
            android:textColor="@color/color_font_normal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22px"
            android:text="@string/detail_no_person"/>
    </com.zhy.autolayout.AutoLinearLayout>
    <com.zhy.autolayout.AutoRelativeLayout
        android:id="@+id/mPersonLayout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.zhy.autolayout.AutoRelativeLayout
            android:id="@+id/mLeftLayout"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <com.zhy.autolayout.AutoLinearLayout
                android:id="@+id/mActorListLayout"
                android:visibility="visible"
                android:layout_width="520px"
                android:layout_height="match_parent">
                <com.widget.custom.MemoryListView
                    android:id="@+id/mGridActorList"
                    android:scrollbars="none"
                    android:nextFocusRight="@+id/mButtonMovie"
                    android:layout_width="460px"
                    android:layout_height="match_parent"
                    android:layout_marginTop="80px"
                    android:listSelector="@drawable/selector_actor_list"
                    android:divider="@android:color/transparent"
                    android:dividerHeight="1px"/>
                <ImageView
                    android:id="@+id/mActorListIndicator"
                    android:background="@mipmap/ic_right_gray_arrow"
                    android:visibility="gone"
                    android:layout_width="18px"
                    android:layout_height="32px"
                    android:layout_marginLeft="20px"/>
            </com.zhy.autolayout.AutoLinearLayout>
            <com.zhy.autolayout.AutoLinearLayout
                android:id="@+id/mEmptyLeftLayout"
                android:visibility="gone"
                android:layout_width="167px"
                android:layout_height="match_parent"/>
        </com.zhy.autolayout.AutoRelativeLayout>
        <com.zhy.autolayout.AutoRelativeLayout
            android:id="@+id/mDetailLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10px"
            android:layout_marginTop="81px"
            android:layout_marginRight="60px"
            android:layout_toRightOf="@+id/mLeftLayout">
            <ImageView
                android:id="@+id/mImgHeader"
                android:layout_width="393px"
                android:layout_height="555px"
                android:scaleType="fitXY"/>
            <com.zhy.autolayout.AutoLinearLayout
                android:orientation="vertical"
                android:id="@+id/mInfoLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30px"
                android:layout_toRightOf="@+id/mImgHeader"
                android:layout_alignBottom="@+id/mImgHeader">
                <com.zhy.autolayout.AutoLinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="28px"
                        android:textStyle="bold"
                        android:textColor="@color/color_detail_font_des"
                        android:ellipsize="marquee"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="660px"
                        android:text="@string/detail_name"
                        android:singleLine="true"
                        android:includeFontPadding="false"/>
                    <com.module.childlock.view.MarqueTextView
                        android:textSize="28px"
                        android:textColor="@color/color_font_normal"
                        android:ellipsize="marquee"
                        android:id="@+id/tvName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:includeFontPadding="false"/>
                </com.zhy.autolayout.AutoLinearLayout>
                <com.zhy.autolayout.AutoLinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30px">
                    <TextView
                        android:textSize="28px"
                        android:textStyle="bold"
                        android:textColor="@color/color_detail_font_des"
                        android:ellipsize="marquee"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="660px"
                        android:text="@string/detail_born"
                        android:singleLine="true"
                        android:includeFontPadding="false"/>
                    <com.module.childlock.view.MarqueTextView
                        android:textSize="28px"
                        android:textColor="@color/color_font_normal"
                        android:ellipsize="marquee"
                        android:id="@+id/tvBorn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:includeFontPadding="false"/>
                </com.zhy.autolayout.AutoLinearLayout>
                <com.zhy.autolayout.AutoFrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="30px">
                    <TextView
                        android:textSize="28px"
                        android:textColor="@color/sel_text_color_white"
                        android:ellipsize="end"
                        android:id="@+id/mTextAwards"
                        android:background="@drawable/selector_base_bg_forget_pwd"
                        android:paddingRight="5px"
                        android:nextFocusUp="@+id/mTextAwards"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:includeFontPadding="false"/>
                    <TextView
                        android:textSize="28px"
                        android:textStyle="bold"
                        android:textColor="@color/select_vod_text_synopsis_color"
                        android:ellipsize="marquee"
                        android:id="@+id/tvAwardsDes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="660px"
                        android:text="@string/detail_awards"
                        android:singleLine="true"
                        android:includeFontPadding="false"/>
                    <TextView
                        android:textSize="28px"
                        android:textColor="@color/sel_text_main_color_white"
                        android:layout_gravity="bottom|right"
                        android:id="@+id/tvAwardsMore"
                        android:background="@drawable/selector_base_bg_forget_pwd"
                        android:paddingLeft="10px"
                        android:paddingRight="10px"
                        android:focusable="true"
                        android:visibility="invisible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/more_info"
                        android:includeFontPadding="false"
                        android:paddingHorizontal="10px"/>
                </com.zhy.autolayout.AutoFrameLayout>
                <com.zhy.autolayout.AutoFrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30px">
                    <TextView
                        android:textSize="28px"
                        android:textColor="@color/sel_text_color_white"
                        android:ellipsize="end"
                        android:id="@+id/mTextIntroduction"
                        android:background="@drawable/selector_base_bg_forget_pwd"
                        android:paddingRight="5px"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:includeFontPadding="false"/>
                    <TextView
                        android:textSize="28px"
                        android:textStyle="bold"
                        android:textColor="@color/select_vod_text_synopsis_color"
                        android:ellipsize="marquee"
                        android:id="@+id/tvIntroductionDes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="660px"
                        android:text="@string/detail_cast_introduction"
                        android:singleLine="true"
                        android:includeFontPadding="false"/>
                    <TextView
                        android:textSize="28px"
                        android:textColor="@color/sel_text_main_color_white"
                        android:layout_gravity="bottom|right"
                        android:id="@+id/tvIntroductionMore"
                        android:background="@drawable/selector_base_bg_forget_pwd"
                        android:paddingLeft="10px"
                        android:paddingRight="10px"
                        android:focusable="true"
                        android:visibility="invisible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/more_info"
                        android:includeFontPadding="false"
                        android:paddingHorizontal="10px"/>
                </com.zhy.autolayout.AutoFrameLayout>
                <TextView
                    android:textSize="28px"
                    android:textStyle="bold"
                    android:textColor="@color/color_detail_font_des"
                    android:ellipsize="marquee"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="70px"
                    android:text="@string/detail_filmography"
                    android:singleLine="true"
                    android:includeFontPadding="false"/>
                <com.zhy.autolayout.AutoRelativeLayout
                    android:id="@+id/mWorksLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20px">
                    <Button
                        android:textSize="36px"
                        android:textColor="@color/selector_color_actor"
                        android:gravity="center"
                        android:id="@+id/mButtonMovie"
                        android:background="@drawable/btn_selector_blue_gray"
                        android:nextFocusLeft="@+id/mGridActorList"
                        android:nextFocusRight="@+id/mButtonSeries"
                        android:nextFocusDown="@+id/mGridWorksList"
                        android:layout_width="320px"
                        android:layout_height="80px"
                        android:text="@string/detail_movies"/>
                    <Button
                        android:textSize="36px"
                        android:textColor="@color/selector_color_actor"
                        android:gravity="center"
                        android:id="@+id/mButtonSeries"
                        android:background="@drawable/btn_selector_blue_gray"
                        android:nextFocusLeft="@+id/mButtonMovie"
                        android:nextFocusRight="@+id/mButtonSeries"
                        android:nextFocusDown="@+id/mGridWorksList"
                        android:layout_width="320px"
                        android:layout_height="80px"
                        android:layout_marginLeft="40px"
                        android:text="@string/detail_series"
                        android:layout_toRightOf="@+id/mButtonMovie"/>
                    <TextView
                        android:textSize="28px"
                        android:textColor="@color/color_font_normal"
                        android:gravity="end|bottom"
                        android:id="@+id/mTextPageIndicator"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:layout_toRightOf="@+id/mButtonSeries"
                        android:layout_alignBottom="@+id/mButtonSeries"
                        android:layout_alignParentRight="true"/>
                </com.zhy.autolayout.AutoRelativeLayout>
            </com.zhy.autolayout.AutoLinearLayout>
        </com.zhy.autolayout.AutoRelativeLayout>
        <com.zhy.autolayout.AutoRelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/mLeftLayout"
            android:layout_below="@+id/mDetailLayout">
            <TextView
                android:textSize="28px"
                android:textColor="@color/color_font_normal"
                android:id="@+id/mTextNoWorksTip"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="210px"
                android:text="@string/detail_no_related_works"
                android:layout_centerHorizontal="true"/>
            <com.open.leanback.widget.VerticalGridView
                android:id="@+id/mGridWorksList"
                android:paddingLeft="10px"
                android:paddingTop="30px"
                android:paddingRight="25px"
                android:paddingBottom="30px"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10px"
                android:layout_toLeftOf="@+id/mPageIndicatorLayout"
                app:focusOutFront="true"
                app:horizontalMargin="65px"
                app:numberOfColumns="5"
                app:verticalMargin="65px"/>
            <com.zhy.autolayout.AutoLinearLayout
                android:orientation="vertical"
                android:id="@+id/mPageIndicatorLayout"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="126px"
                android:layout_marginRight="26px"
                android:layout_alignParentRight="true">
                <ImageView
                    android:id="@+id/mImageUpArrow"
                    android:background="@drawable/selector_circle_arrow_up"
                    android:layout_width="40px"
                    android:layout_height="40px"/>
                <ImageView
                    android:id="@+id/mImageDownArrow"
                    android:background="@drawable/selector_circle_arrow_down"
                    android:layout_width="40px"
                    android:layout_height="40px"
                    android:layout_marginTop="47px"/>
            </com.zhy.autolayout.AutoLinearLayout>
        </com.zhy.autolayout.AutoRelativeLayout>
    </com.zhy.autolayout.AutoRelativeLayout>
    <com.module.view.LoadingView
        android:id="@+id/mLoadingView"
        android:visibility="visible"
        android:layout_width="280px"
        android:layout_height="280px"
        android:layout_centerInParent="true"/>
</com.zhy.autolayout.AutoRelativeLayout>
