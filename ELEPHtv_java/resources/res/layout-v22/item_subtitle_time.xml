<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="30px"
    android:layout_marginTop="30px">
    <TextView
        android:textSize="32px"
        android:textColor="@color/color_ffffff"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/vod_subtitle_time_title"/>
    <ImageView
        android:id="@+id/ivForward"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusLeft="@+id/ivForward"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40px"
        android:src="@drawable/sel_subtitle_time_forward"/>
    <TextView
        android:textSize="20px"
        android:textColor="@color/color_c4c4c4"
        android:gravity="center"
        android:id="@+id/tvTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16px"/>
    <ImageView
        android:id="@+id/ivBack"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16px"
        android:src="@drawable/sel_subtitle_time_back"/>
    <TextView
        android:textSize="24px"
        android:textColor="@color/color_ffffff"
        android:gravity="center"
        android:id="@+id/tvReset"
        android:background="@drawable/sel_bg_subtitle_reset"
        android:paddingLeft="21px"
        android:paddingTop="11px"
        android:paddingRight="21px"
        android:paddingBottom="11px"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusRight="@+id/tvReset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40px"
        android:text="@string/vod_subtitle_time_reset"
        android:paddingHorizontal="21px"
        android:paddingVertical="11px"/>
</com.zhy.autolayout.AutoLinearLayout>
