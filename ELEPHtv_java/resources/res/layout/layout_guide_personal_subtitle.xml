<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="32px"
        android:textColor="@color/color_333333"
        android:gravity="center_vertical"
        android:id="@+id/mTextContent"
        android:tag="mTextContent"
        android:background="@drawable/bg_dialog_guide_down_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="1044px"
        android:text="@string/dialog_guide_personal_subtitle"/>
    <Button
        android:textColor="@color/color_ffffff"
        android:id="@+id/mButton"
        android:tag="mButton"
        android:layout_marginLeft="60px"
        android:layout_marginTop="30px"
        android:text="@string/dialog_guide_next"
        android:layout_toRightOf="@+id/mTextContent"
        style="@style/button_guide_style"/>
</com.zhy.autolayout.AutoRelativeLayout>
