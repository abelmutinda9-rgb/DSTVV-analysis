<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.zhy.autolayout.AutoLinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/mLayoutPassword"
        android:background="@drawable/bg_dialog_brasiliptv"
        android:layout_width="980px"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="40px"
            android:textColor="@color/color_ffffffff"
            android:gravity="center"
            android:id="@+id/mDialogTitle"
            android:background="@drawable/dialog_title_bg"
            android:layout_width="match_parent"
            android:layout_height="100px"
            android:text="@string/personal_setting_login_password"/>
        <com.zhy.autolayout.AutoLinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/mLayoutModify"
            android:paddingTop="30px"
            android:paddingBottom="60px"
            android:visibility="gone"
            android:layout_width="820px"
            android:layout_height="wrap_content">
            <com.zhy.autolayout.AutoLinearLayout
                android:orientation="vertical"
                android:id="@+id/mLayoutOriginal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="28px"
                    android:textColor="@color/color_ffffffff"
                    android:gravity="center"
                    android:id="@+id/mTextInitial"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/personal_password_original"/>
                <EditText
                    android:id="@+id/mEditPasswordOriginal"
                    android:layout_marginTop="5px"
                    android:hint="@string/personal_password_format"
                    android:maxLength="12"
                    style="@style/edit_dialog_style"/>
            </com.zhy.autolayout.AutoLinearLayout>
            <com.zhy.autolayout.AutoLinearLayout
                android:orientation="vertical"
                android:id="@+id/mLayoutNew"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20px">
                <TextView
                    android:textSize="28px"
                    android:textColor="@color/color_ffffffff"
                    android:gravity="center"
                    android:id="@+id/mTextNew"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/personal_password_new"/>
                <EditText
                    android:id="@+id/mEditPasswordNew"
                    android:layout_marginTop="5px"
                    android:hint="@string/personal_password_format"
                    android:maxLength="12"
                    style="@style/edit_dialog_style"/>
            </com.zhy.autolayout.AutoLinearLayout>
            <com.zhy.autolayout.AutoLinearLayout
                android:orientation="vertical"
                android:id="@+id/mLayoutConfirm"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20px">
                <TextView
                    android:textSize="28px"
                    android:textColor="@color/color_ffffffff"
                    android:gravity="center"
                    android:id="@+id/mTextConfirm"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/personal_password_comfirm"/>
                <EditText
                    android:id="@+id/mEditPasswordConfirm"
                    android:nextFocusDown="@+id/mBtnConfirm"
                    android:layout_marginTop="5px"
                    android:hint="@string/personal_password_format"
                    android:maxLength="12"
                    style="@style/edit_dialog_style"/>
            </com.zhy.autolayout.AutoLinearLayout>
            <TextView
                android:textSize="24px"
                android:textColor="@color/text_color"
                android:gravity="center"
                android:layout_gravity="right"
                android:id="@+id/mTextForget"
                android:background="@drawable/selector_base_text_bg"
                android:paddingLeft="5px"
                android:paddingRight="5px"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10px"
                android:text="@string/account_retrieve_password"/>
            <com.zhy.autolayout.AutoLinearLayout
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30px">
                <Button
                    android:id="@+id/mBtnConfirm"
                    android:nextFocusUp="@+id/mTextForget"
                    android:text="@string/dlg_ok"
                    style="@style/button_double_style"/>
                <Button
                    android:id="@+id/mBtnCancel"
                    android:nextFocusUp="@+id/mTextForget"
                    android:layout_marginLeft="58px"
                    android:text="@string/dlg_cancel"
                    style="@style/button_double_style"/>
            </com.zhy.autolayout.AutoLinearLayout>
        </com.zhy.autolayout.AutoLinearLayout>
        <com.zhy.autolayout.AutoLinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/mLayoutSet"
            android:visibility="visible"
            android:layout_width="740px"
            android:layout_height="wrap_content">
            <com.zhy.autolayout.AutoLinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="85px">
                <TextView
                    android:textSize="28px"
                    android:textColor="@color/color_ffffffff"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/personal_password_initial"/>
                <EditText
                    android:id="@+id/mEditPasswordSetInitial"
                    android:layout_marginTop="5px"
                    android:hint="@string/personal_password_format"
                    android:maxLength="12"
                    style="@style/edit_dialog_style"/>
            </com.zhy.autolayout.AutoLinearLayout>
            <com.zhy.autolayout.AutoLinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="125px"
                android:layout_marginBottom="60px">
                <Button
                    android:id="@+id/mBtnSetConfirm"
                    android:text="@string/dlg_ok"
                    style="@style/button_single_style"/>
            </com.zhy.autolayout.AutoLinearLayout>
        </com.zhy.autolayout.AutoLinearLayout>
    </com.zhy.autolayout.AutoLinearLayout>
    <com.module.view.DialogBottomBar
        android:id="@+id/mBottomBar"
        android:visibility="gone"
        android:layout_width="980px"
        android:layout_height="wrap_content"
        android:layout_below="@+id/mLayoutPassword"/>
    <com.module.view.LoadingView
        android:id="@+id/mLoadingView"
        android:visibility="gone"
        android:layout_width="180px"
        android:layout_height="180px"
        android:layout_centerInParent="true"/>
</com.zhy.autolayout.AutoRelativeLayout>
