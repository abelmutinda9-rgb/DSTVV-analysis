<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.zhy.autolayout.AutoLinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_dialog_brasiliptv"
        android:layout_width="865px"
        android:layout_height="561px">
        <com.swlauthnew.view.CustomTextView
            android:textSize="40px"
            android:textColor="@color/color_ffffff"
            android:gravity="center"
            android:id="@+id/mTextTitle"
            android:background="@drawable/dialog_title_bg"
            android:paddingLeft="30px"
            android:paddingRight="30px"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="80px"
            android:text="@string/dialog_tips"
            style="@style/marquee_textview"/>
        <com.zhy.autolayout.AutoLinearLayout
            android:orientation="vertical"
            android:id="@+id/llActiving"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="36px"
                android:textColor="@color/color_ffffff"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/mTextShowCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="116px"
                android:text="2514-5874-6587-2541"/>
            <com.zhy.autolayout.AutoLinearLayout
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/mLayoutActiving"
                android:layout_width="520px"
                android:layout_height="68px"
                android:layout_marginTop="73px">
                <TextView
                    android:textSize="36px"
                    android:textColor="@color/color_ffaa00"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/activing_new"/>
                <ImageView
                    android:layout_gravity="bottom"
                    android:id="@+id/mImageActiving"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="9px"
                    android:layout_marginBottom="15px"
                    android:src="@drawable/icon_activing3"/>
            </com.zhy.autolayout.AutoLinearLayout>
        </com.zhy.autolayout.AutoLinearLayout>
        <com.zhy.autolayout.AutoLinearLayout
            android:orientation="vertical"
            android:id="@+id/mLayoutExit"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="32px"
                android:textColor="@color/color_ffffff"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/mTextTips"
                android:padding="30px"
                android:layout_width="match_parent"
                android:layout_height="0px"
                android:text="激活成功！10分钟后生效，您的应用可继续观看365天。"
                android:layout_weight="1"/>
            <Button
                android:textSize="32px"
                android:textColor="@color/color_ffffff"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/mButtonExit"
                android:background="@drawable/bg_btn_selector_brasiliptv_redmption"
                android:layout_width="420px"
                android:layout_height="58px"
                android:layout_marginBottom="45px"
                android:text="@string/exit_new"/>
        </com.zhy.autolayout.AutoLinearLayout>
        <com.zhy.autolayout.AutoLinearLayout
            android:orientation="vertical"
            android:id="@+id/llExchangeFail"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.zhy.autolayout.AutoLinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/llRemeedFail1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="74px"
                android:layout_marginTop="44px">
                <TextView
                    android:textSize="28px"
                    android:textColor="@color/color_c4c4c4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/redeem_code"/>
                <TextView
                    android:textSize="32px"
                    android:textColor="@color/color_c4c4c4"
                    android:id="@+id/tvRedeemCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </com.zhy.autolayout.AutoLinearLayout>
            <com.zhy.autolayout.AutoLinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/llRemeedFail2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="74px"
                android:layout_marginTop="15px">
                <TextView
                    android:textSize="28px"
                    android:textColor="@color/color_c4c4c4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/redeem_code_status"/>
                <TextView
                    android:textSize="32px"
                    android:textColor="@color/color_c4c4c4"
                    android:id="@+id/tvRedeemCodeStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </com.zhy.autolayout.AutoLinearLayout>
            <com.zhy.autolayout.AutoLinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/llRemeedFail3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="74px"
                android:layout_marginTop="15px">
                <TextView
                    android:textSize="28px"
                    android:textColor="@color/color_c4c4c4"
                    android:id="@+id/tvRedeemTimeDes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="32px"
                    android:textColor="@color/color_c4c4c4"
                    android:id="@+id/tvRedeemTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </com.zhy.autolayout.AutoLinearLayout>
            <com.zhy.autolayout.AutoLinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/llRemeedFail4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="74px"
                android:layout_marginTop="15px">
                <TextView
                    android:textSize="28px"
                    android:textColor="@color/color_c4c4c4"
                    android:id="@+id/tvRedeemOtherDes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="32px"
                    android:textColor="@color/color_c4c4c4"
                    android:id="@+id/tvRedeemOther"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </com.zhy.autolayout.AutoLinearLayout>
            <TextView
                android:textSize="24px"
                android:textColor="@color/color_ffaa00"
                android:id="@+id/tvRedeemTips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="72px"
                android:layout_marginTop="10px"
                android:layout_marginRight="72px"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <com.zhy.autolayout.AutoLinearLayout
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <Button
                    android:textSize="32px"
                    android:textColor="@color/color_ffffff"
                    android:gravity="center"
                    android:id="@+id/btnConfirm"
                    android:background="@drawable/bg_btn_selector_brasiliptv_redmption"
                    android:layout_width="320px"
                    android:layout_height="68px"
                    android:layout_marginBottom="30px"
                    android:text="@string/button_confirm_new"/>
                <Button
                    android:textSize="32px"
                    android:textColor="@color/color_ffffff"
                    android:gravity="center"
                    android:id="@+id/btnReEnter"
                    android:background="@drawable/bg_btn_selector_brasiliptv_redmption"
                    android:layout_width="320px"
                    android:layout_height="68px"
                    android:layout_marginLeft="78px"
                    android:layout_marginBottom="30px"
                    android:text="@string/button_re_enter_new"/>
            </com.zhy.autolayout.AutoLinearLayout>
        </com.zhy.autolayout.AutoLinearLayout>
    </com.zhy.autolayout.AutoLinearLayout>
</com.zhy.autolayout.AutoFrameLayout>
