<?xml version="1.0" encoding="utf-8"?>
<com.common.utils.mark.vod.category.VodCategoryRootView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rlContent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <HorizontalScrollView
        android:id="@+id/mScrollView"
        android:scrollbars="none"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true">
        <com.zhy.autolayout.AutoLinearLayout
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ViewStub
                android:id="@+id/mVsNormalSearch"
                android:layout="@layout/layout_vod_category_normal_search"
                android:layout_width="320px"
                android:layout_height="match_parent"/>
            <ViewStub
                android:id="@+id/mVsBlSearch"
                android:layout="@layout/layout_vod_category_bl_search"
                android:layout_width="320px"
                android:layout_height="match_parent"/>
            <ImageView
                android:id="@+id/mIvArrow"
                android:paddingLeft="31px"
                android:paddingTop="95px"
                android:paddingRight="31px"
                android:visibility="gone"
                android:layout_width="80px"
                android:layout_height="match_parent"
                android:layout_marginLeft="41px"
                android:src="@mipmap/img_vod_arrow_left"/>
            <View
                android:id="@+id/mVInterval"
                android:visibility="visible"
                android:layout_width="20px"
                android:layout_height="match_parent"/>
            <com.common.utils.mark.vod.category.VodCategoryRightPanel
                android:clipToPadding="false"
                android:layout_width="1840px"
                android:layout_height="match_parent">
                <com.zhy.autolayout.AutoFrameLayout
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="140px"
                    android:layout_marginBottom="45px">
                    <TextView
                        android:textSize="24sp"
                        android:textColor="@color/color_font_main"
                        android:gravity="center"
                        android:id="@+id/mTvNoResult"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/vod_search_no_content"/>
                    <com.open.leanback.widget.VerticalGridView
                        android:id="@+id/mGridProgram"
                        android:paddingLeft="20px"
                        android:paddingTop="30px"
                        android:paddingRight="40px"
                        android:paddingBottom="15px"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:horizontalMargin="45px"
                        app:numberOfColumns="6"
                        app:verticalMargin="45px"/>
                </com.zhy.autolayout.AutoFrameLayout>
                <TextView
                    android:textSize="24px"
                    android:textColor="@color/color_font_normal"
                    android:gravity="center"
                    android:id="@+id/mTvAdultTips"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20px"
                    android:layout_marginTop="23px"
                    android:text="@string/adult_want_watch_live"
                    android:singleLine="true"/>
                <TextView
                    android:textSize="40px"
                    android:textColor="@color/color_font_main"
                    android:gravity="center"
                    android:id="@+id/mTextTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20px"
                    android:layout_marginTop="70px"
                    android:singleLine="true"/>
                <TextView
                    android:textSize="28px"
                    android:textColor="@color/color_ff8300"
                    android:gravity="center"
                    android:id="@+id/mTextTotal"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20px"
                    android:layout_marginTop="75px"
                    android:singleLine="true"
                    android:layout_toRightOf="@+id/mTextTitle"/>
                <TextView
                    android:textSize="32px"
                    android:textColor="@color/color_font_second"
                    android:gravity="center"
                    android:id="@+id/mTextPage"
                    android:layout_width="400px"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="710px"
                    android:singleLine="true"
                    android:layout_alignBottom="@+id/mTextTitle"/>
                <TextView
                    android:textSize="24px"
                    android:textColor="@color/color_font_second"
                    android:gravity="center"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="40px"
                    android:text="@string/selete_page_hit"
                    android:singleLine="true"
                    android:layout_alignBottom="@+id/mTextTitle"
                    android:layout_alignParentRight="true"/>
                <com.widget.view.MainUpView
                    android:id="@+id/mMainUpView"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </com.common.utils.mark.vod.category.VodCategoryRightPanel>
        </com.zhy.autolayout.AutoLinearLayout>
    </HorizontalScrollView>
    <TextView
        android:textSize="200px"
        android:textStyle="bold"
        android:textColor="@color/color_ffffffff"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/mTextInputNumber"
        android:background="@mipmap/bg_shadow_number_input"
        android:visibility="gone"
        android:layout_width="512px"
        android:layout_height="512px"
        android:maxLength="4"/>
    <com.module.view.LoadingView
        android:layout_gravity="center"
        android:id="@+id/mLoadingView"
        android:visibility="gone"
        android:layout_width="280px"
        android:layout_height="280px"/>
</com.common.utils.mark.vod.category.VodCategoryRootView>
