<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/mIvTeamLogo"
        android:layout_width="48px"
        android:layout_height="48px"
        android:layout_marginRight="9px"/>
    <TextView
        android:textSize="28px"
        android:textColor="@color/color_font_main"
        android:ellipsize="end"
        android:gravity="right"
        android:layout_gravity="center_vertical"
        android:id="@+id/mTvTeamName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="9px"
        android:layout_marginRight="63px"
        android:singleLine="true"/>
</com.zhy.autolayout.AutoFrameLayout>
