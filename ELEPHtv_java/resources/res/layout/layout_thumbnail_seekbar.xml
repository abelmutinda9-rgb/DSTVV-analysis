<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.zhy.autolayout.AutoFrameLayout
        android:id="@+id/mPreviewFrameLayout"
        android:visibility="invisible"
        android:layout_width="420px"
        android:layout_height="280px">
        <com.zhy.autolayout.AutoFrameLayout
            android:id="@+id/mPreviewThumbnail"
            android:background="@drawable/video_frame"
            android:layout_width="420px"
            android:layout_height="237px">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/mIvLoading"
                android:background="@drawable/loading_thumbnail"
                android:visibility="invisible"
                android:layout_width="112px"
                android:layout_height="112px"/>
            <ImageView
                android:id="@+id/mIvSeekPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"/>
        </com.zhy.autolayout.AutoFrameLayout>
        <TextView
            android:textSize="28px"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/mTvPreviewTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
    </com.zhy.autolayout.AutoFrameLayout>
    <TextView
        android:textSize="28px"
        android:textColor="#ffffff"
        android:id="@+id/mTvCurrentTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="80px"
        android:layout_marginTop="10px"
        android:text="00:00:00"
        android:singleLine="true"
        android:layout_below="@+id/mPreviewFrameLayout"/>
    <com.module.previewseekbar.PreviewSeekBar
        android:id="@+id/mPreviewSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2px"
        android:maxHeight="10px"
        android:layout_toLeftOf="@+id/mTvMaxTime"
        android:layout_toRightOf="@+id/mTvCurrentTime"
        android:layout_below="@+id/mPreviewFrameLayout"
        android:layout_alignTop="@+id/mTvCurrentTime"
        app:previewFrameLayout="@+id/mPreviewFrameLayout"/>
    <TextView
        android:textSize="28px"
        android:textColor="#8a8f99"
        android:id="@+id/mTvMaxTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="80px"
        android:text="00:00:00"
        android:singleLine="true"
        android:layout_below="@+id/mPreviewFrameLayout"
        android:layout_alignTop="@+id/mTvCurrentTime"
        android:layout_alignParentRight="true"/>
</merge>
