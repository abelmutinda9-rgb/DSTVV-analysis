<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/mIvArrow"
        android:tag="mThumbnailArrow"
        android:focusable="true"
        android:layout_width="160px"
        android:layout_height="144px"
        android:src="@drawable/ic_guide_thumbnail_arrow"/>
    <TextView
        android:textSize="32px"
        android:textColor="@color/color_ffffff"
        android:gravity="center_vertical"
        android:id="@+id/mTextContent"
        android:tag="mTextContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="1142px"
        android:text="@string/dialog_guide_thumbnail"
        android:layout_toRightOf="@+id/mIvArrow"
        android:layout_centerVertical="true"/>
</com.zhy.autolayout.AutoRelativeLayout>
