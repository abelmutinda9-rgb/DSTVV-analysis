<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@drawable/bg_coupon_content"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="140px"
    android:layout_marginLeft="25px"
    android:layout_marginTop="5px"
    android:layout_marginRight="25px"
    android:layout_marginBottom="5px">
    <com.zhy.autolayout.AutoFrameLayout
        android:background="@mipmap/icon_coupons_left_select"
        android:duplicateParentState="true"
        android:layout_width="230px"
        android:layout_height="match_parent">
        <TextView
            android:textSize="70px"
            android:textColor="@color/color_FFAF28F3"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tvPrice"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100"/>
    </com.zhy.autolayout.AutoFrameLayout>
    <com.zhy.autolayout.AutoLinearLayout
        android:orientation="vertical"
        android:paddingLeft="23px"
        android:paddingTop="13px"
        android:paddingRight="14px"
        android:paddingBottom="10px"
        android:duplicateParentState="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="160px">
        <TextView
            android:textSize="30px"
            android:textColor="@color/color_ffffff"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tvCouponsTitle"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_weight="1"/>
        <TextView
            android:textSize="24px"
            android:textColor="@color/color_ffffff"
            android:gravity="center_vertical"
            android:id="@+id/tvUseOn"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
    </com.zhy.autolayout.AutoLinearLayout>
</com.zhy.autolayout.AutoLinearLayout>
