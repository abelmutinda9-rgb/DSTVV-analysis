<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="503px">
    <TextView
        android:textSize="36px"
        android:textStyle="bold"
        android:textColor="@color/color_font_main"
        android:gravity="top|center_horizontal"
        android:id="@+id/mVerticalTitle"
        android:layout_width="wrap_content"
        android:layout_height="67px"
        android:includeFontPadding="false"/>
    <com.open.leanback.widget.HorizontalGridView
        android:id="@+id/mVerticalList"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="436px"
        android:layout_marginRight="60px"
        android:horizontalSpacing="19px"
        app:focusOutEnd="false"
        app:focusOutFront="true"
        app:focusOutSideEnd="true"
        app:focusOutSideStart="true"/>
</com.zhy.autolayout.AutoLinearLayout>
