<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="32px"
        android:textColor="@color/color_333333"
        android:gravity="center"
        android:id="@+id/mTextContent"
        android:tag="mTextContent"
        android:background="@drawable/bg_dialog_guide_down_right"
        android:layout_width="825px"
        android:layout_height="100px"
        android:maxWidth="880px"
        android:text="@string/match_guide_tips"/>
    <Button
        android:textColor="@color/color_ffffff"
        android:id="@+id/mButton"
        android:tag="mButton"
        android:text="@string/dialog_guide_ok"
        android:layout_below="@+id/mTextContent"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="70px"
        style="@style/button_guide_style"/>
</com.zhy.autolayout.AutoLinearLayout>
