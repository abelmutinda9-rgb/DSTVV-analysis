<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_brasiliptv"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="40px"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/mDialogTitle"
        android:background="@drawable/dialog_title_bg"
        android:layout_width="match_parent"
        android:layout_height="100px"
        android:text="@string/vod_playback_settings"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="60px"
        android:layout_marginRight="40px"/>
    <com.zhy.autolayout.AutoLinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="190px">
        <Button
            android:textSize="32px"
            android:id="@+id/mBtnExit"
            android:background="@drawable/selector_dialog_btn_account"
            android:layout_width="420px"
            android:layout_height="68px"
            android:layout_marginTop="20px"
            android:layout_marginBottom="30px"
            android:text="@string/exit"
            style="@style/btn_exit"/>
        <TextView
            android:textSize="19px"
            android:textColor="@color/color_999999"
            android:gravity="bottom|center_horizontal"
            android:id="@+id/mTvToSettingTip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="61px"
            android:layout_marginRight="61px"
            android:layout_marginBottom="24px"/>
    </com.zhy.autolayout.AutoLinearLayout>
</com.zhy.autolayout.AutoLinearLayout>
