<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mLayoutContainer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.zhy.autolayout.AutoLinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/mLayoutBind"
        android:background="@drawable/bg_dialog_brasiliptv"
        android:layout_width="950px"
        android:layout_height="769px">
        <TextView
            android:textSize="40px"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/mDialogTitle"
            android:background="@drawable/dialog_title_bg"
            android:layout_width="match_parent"
            android:layout_height="100px"
            android:text="@string/account_bind_email"/>
        <com.zhy.autolayout.AutoLinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="75px"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.zhy.autolayout.AutoLinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="28px"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/mTextInitial"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/personal_new_email"/>
                <com.zhy.autolayout.AutoLinearLayout
                    android:layout_width="820px"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20px">
                    <EditText
                        android:id="@+id/mEditEmail"
                        android:nextFocusDown="@+id/mTextGetCode"
                        android:layout_width="466px"
                        android:hint="@string/account_input_email_hint"
                        style="@style/edit_dialog_style"/>
                    <com.module.view.DropDownListView
                        android:id="@+id/mDpView"
                        android:layout_width="338px"
                        android:layout_height="68px"
                        android:layout_marginLeft="15px"/>
                </com.zhy.autolayout.AutoLinearLayout>
                <TextView
                    android:textSize="28px"
                    android:textColor="@color/color_ffffff"
                    android:layout_gravity="left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40px"
                    android:text="@string/dialog_verification_code"/>
                <com.zhy.autolayout.AutoLinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="68px"
                    android:layout_marginTop="20px">
                    <EditText
                        android:textSize="24px"
                        android:textColor="@color/color_ffffff"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/mEditVerificationCode"
                        android:background="@drawable/bg_dialog_input"
                        android:paddingLeft="10px"
                        android:longClickable="false"
                        android:layout_width="280px"
                        android:layout_height="68px"
                        android:singleLine="true"
                        android:maxLength="6"
                        android:textCursorDrawable="@drawable/shape_edit_cursor"/>
                    <TextView
                        android:textSize="28px"
                        android:textColor="@color/color_ffffff"
                        android:gravity="center"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/mTextGetCode"
                        android:background="@drawable/selector_dialog_password"
                        android:focusable="true"
                        android:layout_width="521px"
                        android:layout_height="68px"
                        android:layout_marginLeft="20px"
                        android:text="@string/dialog_get_verification_code"/>
                </com.zhy.autolayout.AutoLinearLayout>
            </com.zhy.autolayout.AutoLinearLayout>
            <com.zhy.autolayout.AutoLinearLayout
                android:gravity="center"
                android:id="@+id/mLayoutPrivacy"
                android:layout_width="820px"
                android:layout_height="wrap_content"
                android:layout_marginTop="35px">
                <CheckBox
                    android:gravity="center"
                    android:id="@+id/mCheckBox"
                    android:nextFocusDown="@+id/mBtnConfirm"
                    android:layout_width="24px"
                    android:layout_height="24px"
                    android:checked="true"
                    android:button="@drawable/selector_button_checkbox"/>
                <TextView
                    android:textSize="24px"
                    android:textColor="@color/color_bbc0c4"
                    android:nextFocusDown="@+id/mBtnConfirm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10px"
                    android:text="@string/personal_read_and_agree"/>
                <TextView
                    android:textSize="24px"
                    android:textColor="@color/color_ffaa00"
                    android:id="@+id/mTextPolicy"
                    android:background="@drawable/sel_bg_forget_pwd"
                    android:focusable="true"
                    android:nextFocusDown="@+id/mBtnConfirm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10px"
                    android:text="@string/personal_read_and_agree_privacy_policy"/>
            </com.zhy.autolayout.AutoLinearLayout>
            <com.zhy.autolayout.AutoLinearLayout
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="60px">
                <Button
                    android:id="@+id/mBtnConfirm"
                    android:layout_height="70px"
                    android:text="@string/dlg_ok"
                    style="@style/button_double_style"/>
                <Button
                    android:id="@+id/mBtnCancel"
                    android:layout_marginLeft="60px"
                    android:text="@string/dlg_cancel"
                    style="@style/button_double_style"/>
            </com.zhy.autolayout.AutoLinearLayout>
        </com.zhy.autolayout.AutoLinearLayout>
    </com.zhy.autolayout.AutoLinearLayout>
    <com.module.view.DialogBottomBar
        android:id="@+id/mBottomBar"
        android:visibility="gone"
        android:layout_width="950px"
        android:layout_height="wrap_content"
        android:layout_below="@+id/mLayoutBind"/>
    <com.module.view.LoadingView
        android:id="@+id/mLoadingView"
        android:visibility="gone"
        android:layout_width="180px"
        android:layout_height="180px"
        android:layout_centerInParent="true"/>
</com.zhy.autolayout.AutoRelativeLayout>
