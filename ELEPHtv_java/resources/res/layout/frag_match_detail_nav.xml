<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingLeft="90px"
    android:paddingRight="90px"
    android:paddingBottom="40px"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="@drawable/match_event_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.zhy.autolayout.AutoLinearLayout
        android:layout_gravity="right"
        android:orientation="horizontal"
        android:id="@+id/mEventInfoWrapper"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="35px"
        android:layout_marginRight="60px">
        <ImageView
            android:layout_width="33px"
            android:layout_height="32px"
            android:src="@drawable/icon_match_event_goal"/>
        <TextView
            android:textSize="24px"
            android:textColor="@color/color_c4c4c4"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5px"
            android:text="@string/goal"/>
        <ImageView
            android:layout_width="24px"
            android:layout_height="32px"
            android:layout_marginLeft="60px"
            android:src="@drawable/icon_match_red_card"/>
        <TextView
            android:textSize="24px"
            android:textColor="@color/color_c4c4c4"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5px"
            android:text="@string/red_card"/>
        <ImageView
            android:layout_width="24px"
            android:layout_height="32px"
            android:layout_marginLeft="60px"
            android:src="@drawable/icon_match_yellow_card"/>
        <TextView
            android:textSize="24px"
            android:textColor="@color/color_c4c4c4"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5px"
            android:text="@string/yellow_card"/>
        <ImageView
            android:layout_width="48px"
            android:layout_height="48px"
            android:layout_marginLeft="60px"
            android:src="@mipmap/icon_match_in_out"/>
        <TextView
            android:textSize="24px"
            android:textColor="@color/color_c4c4c4"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5px"
            android:text="@string/enter_or_leave_the_field"/>
    </com.zhy.autolayout.AutoLinearLayout>
    <com.zhy.autolayout.AutoFrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="100px"
        android:layout_marginBottom="100px">
        <com.zhy.autolayout.AutoLinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="80px"
            android:layout_marginTop="15px">
            <ImageView
                android:id="@+id/mIvVisitTeam"
                android:layout_width="100px"
                android:layout_height="100px"/>
            <TextView
                android:textSize="40px"
                android:textColor="@color/color_ffffff"
                android:layout_gravity="center_vertical"
                android:id="@+id/mTvVisitTeam"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="25px"/>
        </com.zhy.autolayout.AutoLinearLayout>
        <com.zhy.autolayout.AutoLinearLayout
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="80px"
            android:layout_marginBottom="15px">
            <ImageView
                android:id="@+id/mIvHomeTeam"
                android:layout_width="100px"
                android:layout_height="100px"/>
            <TextView
                android:textSize="40px"
                android:textColor="@color/color_ffffff"
                android:layout_gravity="center_vertical"
                android:id="@+id/mTvHomeTeam"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="25px"/>
        </com.zhy.autolayout.AutoLinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:scrollbarSize="0dp"
            android:scrollbarThumbHorizontal="@drawable/shape_scrollbar_match_thumb"
            android:scrollbarTrackHorizontal="@drawable/shape_scrollbar_match_track"
            android:scrollbarStyle="outsideOverlay"
            android:id="@+id/mRvMatchEvent"
            android:paddingLeft="60px"
            android:paddingTop="32px"
            android:paddingRight="60px"
            android:paddingBottom="32px"
            android:focusable="false"
            android:visibility="gone"
            android:scrollbars="horizontal"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbarFadeDuration="0"/>
        <TextView
            android:textSize="32px"
            android:textColor="@color/color_font_main"
            android:layout_gravity="center"
            android:id="@+id/mTvHint"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/match_hint_info_unavailable"/>
        <com.module.view.LoadingView
            android:layout_gravity="center"
            android:id="@+id/mLoading"
            android:visibility="gone"
            android:layout_width="280px"
            android:layout_height="280px"/>
    </com.zhy.autolayout.AutoFrameLayout>
</com.zhy.autolayout.AutoFrameLayout>
