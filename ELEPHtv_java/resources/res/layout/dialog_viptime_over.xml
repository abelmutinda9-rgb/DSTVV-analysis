<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.zhy.autolayout.AutoLinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/bg_dialog_brasiliptv"
        android:layout_width="980px"
        android:layout_height="620px">
        <TextView
            android:textSize="32px"
            android:textColor="@color/color_ffffff"
            android:id="@+id/tx_vip_over"
            android:layout_width="wrap_content"
            android:layout_height="0px"
            android:layout_marginLeft="94px"
            android:layout_marginTop="154px"
            android:layout_marginRight="93px"
            android:text="@string/dialog_vip_over"
            android:layout_weight="1"/>
        <com.zhy.autolayout.AutoLinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40px"
            android:layout_marginBottom="41px">
            <Button
                android:textSize="32px"
                android:textColor="@color/color_ffffff"
                android:id="@+id/vipOverToCancel"
                android:visibility="gone"
                android:layout_marginLeft="80px"
                android:layout_marginRight="80px"
                android:text="@string/pwd_cancel"
                android:layout_weight="1"
                style="@style/button_double_style"/>
            <Button
                android:textSize="32px"
                android:textColor="@color/color_ffffff"
                android:id="@+id/vipOverToCode"
                android:text="@string/dialog_over_redeem_code"
                style="@style/button_double_style"/>
            <Button
                android:textSize="32px"
                android:textColor="@color/color_ffffff"
                android:id="@+id/vipOverToBind"
                android:layout_marginLeft="60px"
                android:text="@string/dialog_bind_now"
                style="@style/button_double_style"/>
        </com.zhy.autolayout.AutoLinearLayout>
    </com.zhy.autolayout.AutoLinearLayout>
</com.zhy.autolayout.AutoLinearLayout>
