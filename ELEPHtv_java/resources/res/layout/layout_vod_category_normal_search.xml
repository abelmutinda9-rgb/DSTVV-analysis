<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@mipmap/vod_category_left_bg"
    android:paddingTop="25px"
    android:visibility="visible"
    android:layout_width="320px"
    android:layout_height="match_parent">
    <com.zhy.autolayout.AutoLinearLayout
        android:id="@+id/mLlSearch"
        android:background="@drawable/selector_category_tab"
        android:paddingLeft="90px"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="80px"
        android:layout_marginTop="30px">
        <ImageView
            android:layout_gravity="center_vertical"
            android:duplicateParentState="true"
            android:layout_width="30px"
            android:layout_height="30px"
            android:src="@drawable/sel_vod_search"/>
        <TextView
            android:textSize="36px"
            android:textColor="@color/sel_text_color_white"
            android:gravity="center_vertical"
            android:duplicateParentState="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="10px"
            android:text="@string/search"/>
    </com.zhy.autolayout.AutoLinearLayout>
    <com.zhy.autolayout.AutoLinearLayout
        android:id="@+id/mLlFilter"
        android:background="@drawable/selector_category_tab"
        android:paddingLeft="90px"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="80px"
        android:layout_marginTop="20px"
        android:layout_marginBottom="25px">
        <ImageView
            android:layout_gravity="center_vertical"
            android:duplicateParentState="true"
            android:layout_width="30px"
            android:layout_height="30px"
            android:src="@drawable/sel_vod_filter"/>
        <TextView
            android:textSize="36px"
            android:textColor="@color/sel_text_color_white"
            android:gravity="center_vertical"
            android:duplicateParentState="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="10px"
            android:text="@string/filter_vodfilter"/>
    </com.zhy.autolayout.AutoLinearLayout>
    <View
        android:background="@color/color_66ffffff"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <com.open.leanback.widget.VerticalGridView
        android:id="@+id/mGridCategory"
        android:layout_width="300px"
        android:layout_height="match_parent"
        android:layout_marginLeft="10px"
        android:layout_marginTop="44px"
        android:layout_marginRight="10px"
        android:verticalSpacing="10px"
        app:numberOfColumns="1"/>
</com.zhy.autolayout.AutoLinearLayout>
