<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="48px"
        android:textColor="@color/color_c4c4c4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="80px"
        android:layout_marginTop="100px"
        android:text="@string/personal_lock_button"/>
    <TextView
        android:textSize="40px"
        android:textColor="@color/color_ffffffff"
        android:id="@+id/tvLockStatusDes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="80px"
        android:layout_marginTop="192px"
        android:text="@string/cr_switch_state"/>
    <TextView
        android:textSize="40px"
        android:textColor="@color/color_ffaa00"
        android:id="@+id/tvLockStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/tvLockStatusDes"
        android:layout_alignTop="@+id/tvLockStatusDes"/>
    <TextView
        android:textSize="28px"
        android:textColor="@color/color_c4c4c4"
        android:id="@+id/tvLockDes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="43px"
        android:layout_below="@+id/tvLockStatusDes"
        android:layout_alignLeft="@+id/tvLockStatusDes"/>
    <com.zhy.autolayout.AutoFrameLayout
        android:id="@+id/flLockBg"
        android:layout_width="182px"
        android:layout_height="90px"
        android:layout_marginTop="59px"
        android:layout_below="@+id/tvLockDes"
        android:layout_alignLeft="@+id/tvLockStatusDes">
        <ToggleButton
            android:layout_gravity="center"
            android:id="@+id/mLockBtn"
            android:background="@drawable/vod_sel_switch_btn"
            android:nextFocusRight="@+id/mLockBtn"
            android:nextFocusUp="@+id/mLockBtn"
            android:nextFocusDown="@+id/mLockBtn"
            android:layout_width="148px"
            android:layout_height="58px"
            android:textOn=""
            android:textOff=""/>
    </com.zhy.autolayout.AutoFrameLayout>
</com.zhy.autolayout.AutoRelativeLayout>
