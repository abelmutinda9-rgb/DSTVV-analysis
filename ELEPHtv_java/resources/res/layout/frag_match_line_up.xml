<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingLeft="90px"
    android:paddingRight="90px"
    android:paddingBottom="40px"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="@drawable/match_event_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.zhy.autolayout.AutoLinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="100px"
        android:layout_marginLeft="54px">
        <ImageView
            android:id="@+id/mIvVisitTeam"
            android:layout_width="90px"
            android:layout_height="90px"/>
        <com.module.view.AutoFocusedTextView
            android:textSize="32px"
            android:textColor="@color/color_ffffff"
            android:ellipsize="marquee"
            android:id="@+id/mTvVisitTeam"
            android:layout_width="600px"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10px"
            android:singleLine="true"
            android:marqueeRepeatLimit="marquee_forever"/>
    </com.zhy.autolayout.AutoLinearLayout>
    <com.zhy.autolayout.AutoLinearLayout
        android:gravity="center"
        android:layout_gravity="right"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="100px"
        android:layout_marginRight="60px">
        <com.module.view.AutoFocusedTextView
            android:textSize="32px"
            android:textColor="@color/color_ffffff"
            android:ellipsize="marquee"
            android:gravity="right"
            android:id="@+id/mTvHomeTeam"
            android:layout_width="600px"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:marqueeRepeatLimit="marquee_forever"/>
        <ImageView
            android:id="@+id/mIvHomeTeam"
            android:layout_width="90px"
            android:layout_height="90px"
            android:layout_marginLeft="10px"/>
    </com.zhy.autolayout.AutoLinearLayout>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:layout_width="72px"
        android:layout_height="64px"
        android:layout_marginTop="16px"
        android:src="@drawable/ic_match_vs"
        android:scaleType="fitXY"/>
    <TextView
        android:textSize="32px"
        android:textColor="@color/color_font_main"
        android:layout_gravity="center"
        android:id="@+id/mTvHint"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/match_hint_info_unavailable"/>
    <com.match.view.LineUpView
        android:id="@+id/mLvLineUp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="60px"
        android:layout_marginTop="100px"
        android:layout_marginRight="60px"
        android:layout_marginBottom="100px"/>
    <com.module.view.LoadingView
        android:id="@+id/mLoading"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</com.zhy.autolayout.AutoFrameLayout>
