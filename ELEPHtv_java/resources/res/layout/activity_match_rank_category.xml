<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@drawable/bg_match_detail"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.open.leanback.widget.VerticalGridView
        android:id="@+id/mRvMatch"
        android:background="@color/color_990f0f0f"
        android:paddingTop="90px"
        android:paddingBottom="90px"
        android:visibility="gone"
        android:layout_width="380px"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/mVLine"
        android:background="@color/color_303131"
        android:visibility="gone"
        android:layout_width="2px"
        android:layout_height="match_parent"/>
    <com.zhy.autolayout.AutoFrameLayout
        android:background="@color/color_990f0f0f"
        android:paddingTop="10px"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:id="@+id/mMatchDesc"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="60px"
            layout="@layout/item_match_rank_desc_small"/>
        <androidx.recyclerview.widget.RecyclerView
            android:scrollbarSize="0dp"
            android:scrollbarThumbVertical="@drawable/scrollbar_thumb_match_rank_vertical"
            android:scrollbarTrackVertical="@drawable/scrollbar_track_vertical"
            android:scrollbarAlwaysDrawVerticalTrack="true"
            android:scrollbarStyle="outsideOverlay"
            android:id="@+id/mRvRank"
            android:paddingLeft="40px"
            android:paddingRight="40px"
            android:paddingBottom="20px"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:visibility="gone"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="20px"
            android:layout_marginTop="140px"
            android:layout_marginRight="20px"
            android:fadeScrollbars="false"
            android:overScrollMode="always"/>
        <com.module.view.LoadingView
            android:layout_gravity="center"
            android:id="@+id/mLoading"
            android:visibility="gone"
            android:layout_width="280px"
            android:layout_height="280px"/>
        <com.zhy.autolayout.AutoLinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/mLlNoInternet"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/match_no_internet_icon"/>
            <TextView
                android:textSize="24px"
                android:textColor="@color/color_font_normal"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="13px"
                android:text="@string/match_no_internet"/>
        </com.zhy.autolayout.AutoLinearLayout>
        <com.zhy.autolayout.AutoLinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/mAllNoData"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:layout_width="113px"
                android:layout_height="wrap_content"
                android:src="@drawable/match_no_schedule_icon"
                android:scaleType="fitCenter"/>
            <TextView
                android:textSize="24px"
                android:textColor="@color/color_font_normal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12px"
                android:text="@string/no_data"/>
        </com.zhy.autolayout.AutoLinearLayout>
    </com.zhy.autolayout.AutoFrameLayout>
</com.zhy.autolayout.AutoLinearLayout>
