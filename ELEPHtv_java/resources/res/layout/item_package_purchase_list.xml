<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mRlPackage"
    android:background="@drawable/selector_vod_package_bg"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="144px">
    <com.zhy.autolayout.AutoFrameLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <com.zhy.autolayout.AutoLinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/mLlCouponBg"
            android:background="@drawable/selector_purchase_coupons_bg"
            android:visibility="visible"
            android:duplicateParentState="true"
            android:layout_width="248px"
            android:layout_height="33px"
            android:layout_alignParentTop="true">
            <TextView
                android:textSize="20px"
                android:textColor="@drawable/text_purchase_coupon_selector"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/mTvCouponDiscount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"/>
        </com.zhy.autolayout.AutoLinearLayout>
        <com.zhy.autolayout.AutoLinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="46px">
            <TextView
                android:textSize="48px"
                android:textColor="@color/color_ffffff"
                android:id="@+id/mTvPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="24px"
                android:textColor="@color/color_ffffff"
                android:gravity="right"
                android:id="@+id/mTvPriceType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="40px"
                android:includeFontPadding="false"
                android:layout_toRightOf="@+id/mTvPrice"/>
        </com.zhy.autolayout.AutoLinearLayout>
        <com.zhy.autolayout.AutoLinearLayout
            android:gravity="center_horizontal"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="46px"
            android:layout_marginBottom="19px">
            <TextView
                android:textSize="24px"
                android:textColor="@color/color_4dfffff"
                android:id="@+id/mTvOriginalPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="24px"
                android:textColor="@color/color_ffffff"
                android:gravity="right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="40px"
                android:includeFontPadding="false"
                android:layout_toRightOf="@+id/mTvPrice"/>
        </com.zhy.autolayout.AutoLinearLayout>
    </com.zhy.autolayout.AutoFrameLayout>
    <ImageView
        android:id="@+id/mIvHot"
        android:visibility="gone"
        android:layout_width="75px"
        android:layout_height="75px"
        android:src="@mipmap/vod_icon_package_hot"
        android:layout_alignParentRight="true"/>
    <com.zhy.autolayout.AutoLinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="257px">
        <TextView
            android:textSize="30px"
            android:textColor="@color/color_99ffffff"
            android:id="@+id/mTvName"
            android:background="@drawable/shape_purchase_package_title_bg"
            android:layout_width="490px"
            android:layout_height="54px"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:layout_centerVertical="true"
            style="@style/marqueeText"/>
        <TextView
            android:textSize="24px"
            android:textColor="@color/color_ffffff"
            android:id="@+id/mTvPerDayPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="44px"
            android:layout_marginRight="65px"
            android:layout_centerVertical="true"/>
    </com.zhy.autolayout.AutoLinearLayout>
</com.zhy.autolayout.AutoRelativeLayout>
