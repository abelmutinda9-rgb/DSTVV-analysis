<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_brasiliptv"
    android:layout_width="980px"
    android:layout_height="580px">
    <TextView
        android:textSize="20sp"
        android:textColor="@color/color_ffffff"
        android:gravity="center"
        android:id="@+id/mDialogTitle"
        android:background="@drawable/dialog_title_bg"
        android:layout_width="match_parent"
        android:layout_height="80px"
        android:text="@string/version_upgrade_str"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/color_f5f5f5"
        android:id="@+id/mTextFuncStr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="52px"
        android:layout_marginTop="35px"
        android:text="@string/content_msg_str"
        android:layout_below="@+id/mDialogTitle"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_ffaa00"
        android:id="@+id/mTextCurVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="50px"
        android:layout_alignBottom="@+id/mTextFuncStr"
        android:layout_alignParentRight="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_f5f5f5"
        android:id="@+id/mTextUpdateNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="52px"
        android:layout_marginTop="30px"
        android:layout_marginRight="52px"
        android:maxLines="5"
        android:singleLine="false"
        android:layout_below="@+id/mTextFuncStr"
        android:lineSpacingExtra="10px"/>
    <Button
        android:textSize="16sp"
        android:textColor="@color/text_color"
        android:gravity="center"
        android:id="@+id/mBtnConfirm"
        android:background="@drawable/selector_dialog_btn_account"
        android:layout_width="420px"
        android:layout_height="58px"
        android:layout_marginBottom="60px"
        android:text="@string/confirm"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
    <com.module.view.LoadingView
        android:id="@+id/mLoadingView"
        android:visibility="gone"
        android:layout_width="150px"
        android:layout_height="150px"
        android:layout_centerInParent="true"/>
</com.zhy.autolayout.AutoRelativeLayout>
