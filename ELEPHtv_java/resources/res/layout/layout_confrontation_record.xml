<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="28px"
        android:textColor="@color/color_main"
        android:gravity="center_vertical"
        android:id="@+id/mTvVisitTeamName"
        android:paddingLeft="40px"
        android:paddingRight="40px"
        android:layout_width="355px"
        android:layout_height="wrap_content"
        android:text="@string/match_stat_record_lastest"/>
    <com.zhy.autolayout.AutoLinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="158px"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/mIvVisitTeamLogo"
            android:layout_width="32px"
            android:layout_height="32px"
            android:src="@drawable/ic_team_logo_default"
            android:scaleType="fitCenter"/>
        <TextView
            android:textSize="28px"
            android:textColor="@color/color_main"
            android:id="@+id/mTvScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15px"/>
        <ImageView
            android:id="@+id/mIvHomeTeamLogo"
            android:layout_width="32px"
            android:layout_height="32px"
            android:layout_marginLeft="15px"
            android:src="@drawable/ic_team_logo_default"
            android:scaleType="fitCenter"/>
    </com.zhy.autolayout.AutoLinearLayout>
    <TextView
        android:textSize="28px"
        android:textColor="@color/color_main"
        android:gravity="center"
        android:id="@+id/mTvHomeTeamName"
        android:paddingLeft="40px"
        android:paddingRight="40px"
        android:layout_width="355px"
        android:layout_height="wrap_content"
        android:text="@string/match_stat_record_lastest"/>
    <TextView
        android:textSize="28px"
        android:textColor="@color/color_font_normal"
        android:gravity="center"
        android:id="@+id/mTvDate"
        android:paddingLeft="114px"
        android:layout_width="302px"
        android:layout_height="wrap_content"
        android:text="@string/match_stat_record_date"/>
    <TextView
        android:textSize="28px"
        android:textColor="@color/color_font_normal"
        android:gravity="center"
        android:id="@+id/mTvChampionship"
        android:paddingLeft="234px"
        android:paddingRight="40px"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/match_stat_record_championship"/>
</com.zhy.autolayout.AutoLinearLayout>
