<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:background="@drawable/selector_item_comm_bg"
    android:paddingLeft="22px"
    android:paddingTop="17px"
    android:paddingRight="22px"
    android:paddingBottom="17px"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="28px"
        android:textColor="@color/text_dropdown_item_color"
        android:layout_gravity="center"
        android:id="@+id/tvSeanson"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/ivSelected"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_nation_selected"/>
</com.zhy.autolayout.AutoFrameLayout>
