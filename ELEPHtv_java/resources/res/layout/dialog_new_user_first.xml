<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.zhy.autolayout.AutoLinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/bg_dialog_new_user_first"
        android:layout_width="900px"
        android:layout_height="540px">
        <TextView
            android:textSize="36px"
            android:textColor="@color/color_ffffff"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tx_free_trial"
            android:layout_width="751px"
            android:layout_height="0px"
            android:layout_marginTop="136px"
            android:layout_weight="1"/>
        <TextView
            android:textSize="28px"
            android:textColor="@color/color_ffffff"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/mTvBindTips"
            android:layout_width="674px"
            android:layout_height="0px"
            android:layout_marginTop="31px"
            android:layout_weight="1"/>
        <com.zhy.autolayout.AutoLinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="740px"
            android:layout_height="wrap_content"
            android:layout_marginTop="40px"
            android:layout_marginBottom="60px">
            <Button
                android:textSize="28px"
                android:textColor="@color/color_ffffff"
                android:gravity="center"
                android:id="@+id/mBtnToBind"
                android:background="@drawable/bg_btn_new_first_selector"
                android:layout_width="340px"
                android:layout_height="80px"/>
            <Button
                android:textSize="28px"
                android:textColor="@color/color_ffffff"
                android:gravity="center"
                android:id="@+id/start_to_use"
                android:background="@drawable/bg_btn_new_first_selector"
                android:layout_width="340px"
                android:layout_height="80px"
                android:layout_marginLeft="60px"/>
        </com.zhy.autolayout.AutoLinearLayout>
    </com.zhy.autolayout.AutoLinearLayout>
    <TextView
        android:textColor="@color/color_4d1a00"
        android:gravity="center_horizontal"
        android:layout_gravity="bottom"
        android:id="@+id/mTvCreatAccount"
        android:background="@drawable/bg_dialog_get_bindday_title"
        android:paddingTop="5px"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="50px"
        android:layout_marginLeft="120px"
        android:layout_marginBottom="120px"
        android:text="@string/dialog_free_experience_create_account"/>
    <com.module.view.LoadingView
        android:layout_gravity="center"
        android:id="@+id/mLoadingView"
        android:visibility="gone"
        android:layout_width="180px"
        android:layout_height="180px"/>
</com.zhy.autolayout.AutoFrameLayout>
