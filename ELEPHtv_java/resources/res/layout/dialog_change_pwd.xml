<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.zhy.autolayout.AutoRelativeLayout
        android:orientation="vertical"
        android:id="@+id/mLayoutPassword"
        android:background="@drawable/bg_dialog_brasiliptv"
        android:layout_width="920px"
        android:layout_height="854px">
        <TextView
            android:textSize="40px"
            android:textColor="@color/color_ffffff"
            android:gravity="center"
            android:id="@+id/mTitle"
            android:background="@drawable/dialog_title_bg"
            android:layout_width="wrap_content"
            android:layout_height="100px"
            android:text="@string/change_pwd"/>
        <TextView
            android:textSize="24px"
            android:textColor="@color/color_ffaa00"
            android:id="@+id/mAccountId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32px"
            android:text="@string/account_id"
            android:layout_below="@+id/mTitle"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="28px"
            android:textColor="@color/color_ffffff"
            android:gravity="center"
            android:id="@+id/mTvIssum"
            android:layout_width="820px"
            android:layout_height="wrap_content"
            android:layout_marginTop="42px"
            android:layout_below="@+id/mAccountId"
            android:layout_centerHorizontal="true"/>
        <com.zhy.autolayout.AutoLinearLayout
            android:orientation="vertical"
            android:id="@+id/mLayoutEdit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="60px"
            android:layout_below="@+id/mTvIssum"
            android:layout_centerHorizontal="true">
            <TextView
                android:textSize="28px"
                android:textColor="@color/color_ffffffff"
                android:id="@+id/mSetNew"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reset_new_password"/>
            <EditText
                android:id="@+id/mEditNewPassword"
                android:layout_marginTop="10px"
                android:hint="@string/personal_password_format"
                android:maxLength="12"
                style="@style/edit_dialog_style"/>
            <TextView
                android:textSize="28px"
                android:textColor="@color/color_ffffffff"
                android:id="@+id/mConfirmNew"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="39px"
                android:text="@string/confirm_new_password"/>
            <EditText
                android:id="@+id/mEditConfirmPassword"
                android:layout_marginTop="10px"
                android:hint="@string/personal_password_format"
                android:maxLength="12"
                style="@style/edit_dialog_style"/>
        </com.zhy.autolayout.AutoLinearLayout>
        <TextView
            android:textSize="24px"
            android:textColor="@color/color_8d9194"
            android:id="@+id/mLinkContact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30px"
            android:text="@string/contact_us"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"/>
        <com.zhy.autolayout.AutoLinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="66px"
            android:layout_marginBottom="36px"
            android:layout_above="@+id/mLinkContact"
            android:layout_below="@+id/mLayoutEdit">
            <Button
                android:id="@+id/mBtnLoginOther"
                android:layout_width="380px"
                android:layout_height="68px"
                android:text="@string/sign_in_other_account"
                style="@style/button_single_style"/>
            <Button
                android:id="@+id/mBtnConfirm"
                android:layout_width="380px"
                android:layout_height="68px"
                android:layout_marginLeft="60px"
                android:text="@string/pwd_confim"
                style="@style/button_single_style"/>
        </com.zhy.autolayout.AutoLinearLayout>
    </com.zhy.autolayout.AutoRelativeLayout>
    <com.module.view.DialogBottomBar
        android:id="@+id/mErrorTip"
        android:visibility="gone"
        android:layout_width="920px"
        android:layout_height="wrap_content"
        android:layout_below="@+id/mLayoutPassword"/>
    <com.module.view.LoadingView
        android:id="@+id/mLoadView"
        android:visibility="gone"
        android:layout_width="180px"
        android:layout_height="180px"
        android:layout_centerInParent="true"/>
</com.zhy.autolayout.AutoRelativeLayout>
