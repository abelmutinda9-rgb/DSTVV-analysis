<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.zhy.autolayout.AutoRelativeLayout
        android:orientation="vertical"
        android:id="@+id/mLayoutPassword"
        android:background="@drawable/bg_dialog_brasiliptv"
        android:layout_width="912px"
        android:layout_height="769px">
        <TextView
            android:textSize="20sp"
            android:textColor="@color/color_ffffff"
            android:gravity="center"
            android:id="@+id/mTvTitle"
            android:background="@drawable/dialog_title_bg"
            android:layout_width="match_parent"
            android:layout_height="100px"
            android:text="@string/personal_setting_login_password"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_ffffff"
            android:gravity="left"
            android:id="@+id/mTvPwdHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="58px"
            android:layout_marginTop="46px"
            android:layout_marginRight="58px"
            android:text="@string/personal_enter_password"
            android:layout_below="@+id/mTvTitle"/>
        <EditText
            android:textSize="24px"
            android:textColor="@color/color_ffffff"
            android:gravity="center_vertical"
            android:id="@+id/mEtPwd"
            android:background="@mipmap/bg_dialog_edit"
            android:paddingLeft="10px"
            android:paddingRight="10px"
            android:longClickable="false"
            android:layout_width="match_parent"
            android:layout_height="68px"
            android:layout_marginLeft="58px"
            android:layout_marginTop="20px"
            android:layout_marginRight="58px"
            android:hint="@string/personal_please_enter_password"
            android:singleLine="true"
            android:layout_below="@+id/mTvPwdHint"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_ffffff"
            android:gravity="left"
            android:id="@+id/mTvConfirmPwdHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="58px"
            android:layout_marginTop="40px"
            android:layout_marginRight="58px"
            android:text="@string/personal_confirm_pwd"
            android:layout_below="@+id/mEtPwd"/>
        <EditText
            android:textSize="24px"
            android:textColor="@color/color_ffffff"
            android:gravity="center_vertical"
            android:id="@+id/mEtConfirmPwd"
            android:background="@mipmap/bg_dialog_edit"
            android:paddingLeft="10px"
            android:paddingRight="10px"
            android:nextFocusDown="@+id/mBtnConfirm"
            android:longClickable="false"
            android:layout_width="match_parent"
            android:layout_height="68px"
            android:layout_marginLeft="58px"
            android:layout_marginTop="20px"
            android:layout_marginRight="58px"
            android:hint="@string/personal_please_enter_password_again"
            android:singleLine="true"
            android:layout_below="@+id/mTvConfirmPwdHint"/>
        <TextView
            android:textSize="24px"
            android:textColor="@color/color_a8a8a8"
            android:id="@+id/mTvTips1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="58px"
            android:layout_marginTop="48px"
            android:text="@string/personal_password_tips1"
            android:layout_below="@+id/mEtConfirmPwd"/>
        <TextView
            android:textSize="24px"
            android:textColor="@color/color_a8a8a8"
            android:id="@+id/mTvTips2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="58px"
            android:layout_marginTop="28px"
            android:text="@string/personal_password_tips2"
            android:layout_below="@+id/mTvTips1"/>
        <com.zhy.autolayout.AutoLinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48px"
            android:layout_below="@+id/mTvTips2">
            <Button
                android:id="@+id/mBtnConfirm"
                android:layout_width="367px"
                android:layout_height="80px"
                android:text="@string/dlg_ok"
                style="@style/button_double_style"/>
            <Button
                android:id="@+id/mBtnCancel"
                android:layout_width="367px"
                android:layout_height="80px"
                android:layout_marginLeft="82px"
                android:text="@string/dlg_cancel"
                style="@style/button_double_style"/>
        </com.zhy.autolayout.AutoLinearLayout>
    </com.zhy.autolayout.AutoRelativeLayout>
    <com.module.view.DialogBottomBar
        android:id="@+id/mBottomBar"
        android:visibility="gone"
        android:layout_width="912px"
        android:layout_height="wrap_content"
        android:layout_below="@+id/mLayoutPassword"/>
    <com.module.view.LoadingView
        android:id="@+id/mLoadingView"
        android:visibility="gone"
        android:layout_width="180px"
        android:layout_height="180px"
        android:layout_centerInParent="true"/>
</com.zhy.autolayout.AutoRelativeLayout>
