<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="414px"
    android:layout_height="275px"
    android:layout_marginRight="60px">
    <com.vod.view.RadiusImageView
        android:id="@+id/mHorizonMore"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="232px"
        android:src="@drawable/bg_asset_horizon_more"/>
    <TextView
        android:textSize="32px"
        android:textColor="@color/color_font_normal"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="165px"
        android:text="@string/more_info"
        android:includeFontPadding="false"/>
</com.zhy.autolayout.AutoFrameLayout>
