<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_brasiliptv"
    android:layout_width="580px"
    android:layout_height="980px">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:layout_width="112px"
        android:layout_height="92px"
        android:layout_marginTop="99px"
        android:src="@mipmap/icon_warn"/>
    <TextView
        android:textSize="32px"
        android:textColor="#ffffff"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="37px"
        android:layout_marginTop="76px"
        android:layout_marginRight="39px"
        android:text="@string/reverse_virus_present"/>
    <Button
        android:textSize="32px"
        android:textColor="#ffffff"
        android:ellipsize="marquee"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/mBtnReverseCancel"
        android:background="@drawable/selector_dialog_btn_account"
        android:layout_width="458px"
        android:layout_height="66px"
        android:layout_marginTop="101px"
        android:text="@string/cancel"
        android:singleLine="true"
        android:marqueeRepeatLimit="marquee_forever"/>
</com.zhy.autolayout.AutoLinearLayout>
