<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@mipmap/vod_bg_prompt_bind"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="34px"
        android:textColor="@color/color_font_main"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="111px"
        android:layout_marginTop="145px"
        android:layout_marginRight="111px"
        android:text="@string/bind_account_first"/>
    <TextView
        android:textSize="30px"
        android:textColor="@color/color_999999"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="111px"
        android:layout_marginTop="44px"
        android:layout_marginRight="111px"
        android:text="@string/bind_go_account_security"/>
    <TextView
        android:textSize="30px"
        android:textColor="@color/color_font_main"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/mTvConfirm"
        android:background="@drawable/shape_dialog_prompt_bind_button"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="380px"
        android:layout_height="70px"
        android:layout_marginTop="105px"
        android:text="@string/dlg_ok"/>
</com.zhy.autolayout.AutoLinearLayout>
