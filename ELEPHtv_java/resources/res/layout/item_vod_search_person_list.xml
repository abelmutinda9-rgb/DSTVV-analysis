<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:focusable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:descendantFocusability="afterDescendants"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp">
    <RelativeLayout
        android:id="@+id/rlBroader"
        android:background="@drawable/sel_poster_nohalo"
        android:duplicateParentState="true"
        android:clipChildren="false"
        android:descendantFocusability="blocksDescendants"
        android:layout_width="152dp"
        android:layout_height="223dp">
        <ImageView
            android:id="@+id/ivVideoPoster"
            android:layout_width="152dp"
            android:layout_height="223dp"
            android:src="@drawable/bg_placehoder"
            android:scaleType="fitXY"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_f5f5f5"
            android:gravity="bottom|right"
            android:id="@+id/tvVideoState"
            android:background="@drawable/shape_vod_serial_state_bg"
            android:paddingLeft="3dp"
            android:paddingRight="3dp"
            android:paddingBottom="3dp"
            android:visibility="gone"
            android:layout_width="166dp"
            android:layout_height="66dp"
            android:layout_alignParentBottom="true"
            style="@style/marqueeText"/>
    </RelativeLayout>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_font_second"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tvVideoName"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="visible"
        android:layout_width="152dp"
        android:layout_height="wrap_content"
        style="@style/marqueeText"/>
</LinearLayout>
