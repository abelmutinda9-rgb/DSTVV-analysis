<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zhy.autolayout.AutoLinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/mContainerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="80px"
        android:layout_marginTop="120px"
        android:layout_marginRight="80px">
        <TextView
            android:textSize="48px"
            android:textStyle="bold"
            android:textColor="@color/color_font_normal"
            android:id="@+id/mAppNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting_about_title"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="28px"
            android:textColor="@color/color_font_second"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="60px"
            android:layout_marginBottom="50px"
            android:text="@string/setting_about_info"
            android:layout_below="@+id/mAppNameText"
            android:lineSpacingExtra="10px"/>
    </com.zhy.autolayout.AutoLinearLayout>
    <TextView
        android:textSize="30px"
        android:textColor="@color/color_ffffff"
        android:layout_gravity="bottom|left"
        android:id="@+id/contact_us"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="102px"
        android:layout_marginBottom="206px"
        android:text="@string/about_contact_us"/>
    <com.zhy.autolayout.AutoLinearLayout
        android:layout_gravity="bottom|left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="102px"
        android:layout_marginBottom="144px">
        <com.zhy.autolayout.AutoLinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/mLlServiceEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="28px"
                android:textColor="@color/color_ffffff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/email"/>
            <TextView
                android:textSize="32px"
                android:textColor="@color/color_ff9500"
                android:layout_gravity="center"
                android:id="@+id/tvEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10px"
                android:text="@string/setting_about_email"/>
        </com.zhy.autolayout.AutoLinearLayout>
        <com.zhy.autolayout.AutoLinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/mLlOfficialWeb"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="102px">
            <TextView
                android:textSize="28px"
                android:textColor="@color/color_ffffff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/official_website"/>
            <TextView
                android:textSize="32px"
                android:textColor="@color/color_ff9500"
                android:layout_gravity="center"
                android:id="@+id/tvWeb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10px"/>
        </com.zhy.autolayout.AutoLinearLayout>
    </com.zhy.autolayout.AutoLinearLayout>
    <TextView
        android:textSize="28px"
        android:textColor="@color/color_c4c4c4"
        android:id="@+id/mTextVersion"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="59px"
        android:layout_marginBottom="88px"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"/>
</com.zhy.autolayout.AutoFrameLayout>
