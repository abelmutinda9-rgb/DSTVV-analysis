<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/sel_channel_bg"
    android:focusable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:descendantFocusability="afterDescendants"
    android:layout_width="946px"
    android:layout_height="100px">
    <TextView
        android:textSize="30px"
        android:textColor="@color/color_c4c4c7"
        android:ellipsize="marquee"
        android:gravity="center"
        android:id="@+id/tvChannelName"
        android:layout_width="300px"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginStart="80px"/>
    <TextView
        android:textSize="30px"
        android:textColor="@color/color_c4c4c7"
        android:ellipsize="marquee"
        android:gravity="center"
        android:id="@+id/tvCountry"
        android:layout_width="300px"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_weight="1"
        android:layout_marginStart="10px"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/animationView"
        android:visibility="gone"
        android:layout_width="45px"
        android:layout_height="45px"
        android:layout_marginEnd="40px"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/play_animation"/>
</com.zhy.autolayout.AutoLinearLayout>
