<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zhy.autolayout.AutoLinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_time_remain_unitv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="32px"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/mTextAuthTime"
            android:paddingLeft="30px"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30px"
            android:text="@string/app_out_date_hint"
            android:maxLines="1"
            android:singleLine="true"
            android:drawableLeft="@drawable/icon_text_dot"
            android:drawablePadding="10px"/>
        <com.zhy.autolayout.AutoLinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15px">
            <ImageView
                android:paddingTop="15px"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30px"
                android:src="@drawable/icon_text_dot"/>
            <TextView
                android:textSize="32px"
                android:textColor="@color/white"
                android:gravity="left"
                android:id="@+id/mTextTips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10px"
                android:layout_marginRight="30px"
                android:maxWidth="1000px"
                android:text="@string/get_active_code_hint"/>
        </com.zhy.autolayout.AutoLinearLayout>
        <TextView
            android:textSize="32px"
            android:textColor="@color/color_red"
            android:gravity="center"
            android:layout_gravity="right"
            android:id="@+id/mTextPressMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30px"
            android:layout_marginTop="21px"
            android:layout_marginRight="30px"
            android:layout_marginBottom="30px"
            android:text="@string/press_menu_new"/>
    </com.zhy.autolayout.AutoLinearLayout>
</com.zhy.autolayout.AutoLinearLayout>
