<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rlContainer"
    android:background="@drawable/sel_infobar_channel_bg"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="512px"
    android:layout_height="176px">
    <TextView
        android:textSize="36px"
        android:textColor="@color/color_ffffff"
        android:ellipsize="marquee"
        android:gravity="center_vertical"
        android:id="@+id/tvChannelName"
        android:layout_width="300px"
        android:layout_height="wrap_content"
        android:layout_marginTop="32px"
        android:singleLine="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="66px"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="28px"
        android:textColor="@color/color_59ffffff"
        android:ellipsize="marquee"
        android:gravity="center_vertical"
        android:id="@+id/tvCountry"
        android:layout_width="300px"
        android:layout_height="wrap_content"
        android:layout_marginTop="22px"
        android:singleLine="true"
        android:layout_below="@+id/tvChannelName"
        android:layout_marginStart="66px"
        android:layout_alignParentStart="true"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/animationView"
        android:visibility="gone"
        android:layout_width="45px"
        android:layout_height="45px"
        android:layout_marginTop="24px"
        android:layout_marginRight="24px"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="40px"
        android:layout_alignParentEnd="true"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/play_animation"/>
</com.zhy.autolayout.AutoRelativeLayout>
