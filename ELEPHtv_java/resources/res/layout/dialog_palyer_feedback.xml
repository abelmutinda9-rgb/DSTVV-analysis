<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.zhy.autolayout.AutoFrameLayout
        android:background="@drawable/bg_dialog"
        android:layout_width="812px"
        android:layout_height="312px">
        <com.zhy.autolayout.AutoRelativeLayout
            android:id="@+id/mLayoutFeedback"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/mIvWaring"
                android:layout_width="68px"
                android:layout_height="68px"
                android:layout_marginLeft="40px"
                android:layout_marginTop="40px"
                android:src="@mipmap/icon_error"/>
            <TextView
                android:textSize="32px"
                android:textColor="@android:color/white"
                android:gravity="left"
                android:id="@+id/mTvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30px"
                android:layout_marginTop="40px"
                android:layout_marginRight="40px"
                android:layout_toRightOf="@+id/mIvWaring"/>
            <Button
                android:id="@+id/mBtnFeedback"
                android:background="@drawable/shape_btn_focus"
                android:paddingLeft="20px"
                android:paddingRight="20px"
                android:layout_width="wrap_content"
                android:layout_height="58px"
                android:layout_marginBottom="66px"
                android:text="@string/nd_click_fb"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                style="@style/button_single_style"/>
            <TextView
                android:textSize="24px"
                android:textColor="@color/color_8c9194"
                android:id="@+id/mTvVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="40px"
                android:layout_marginBottom="20px"
                android:layout_alignParentBottom="true"/>
            <TextView
                android:textSize="24px"
                android:textColor="@color/color_8c9194"
                android:id="@+id/mTvPlayer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20px"
                android:layout_marginBottom="20px"
                android:layout_toRightOf="@+id/mTvVersion"
                android:layout_alignParentBottom="true"/>
            <TextView
                android:textSize="24px"
                android:textColor="@color/color_8c9194"
                android:id="@+id/mTvAccount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="40px"
                android:layout_marginBottom="20px"
                android:layout_alignParentRight="true"
                android:layout_alignParentBottom="true"/>
        </com.zhy.autolayout.AutoRelativeLayout>
        <TextView
            android:textSize="32px"
            android:textColor="@color/color_ffffff"
            android:gravity="center"
            android:id="@+id/mTvFbSuccess"
            android:padding="50px"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/nd_fb_suc"/>
    </com.zhy.autolayout.AutoFrameLayout>
</com.zhy.autolayout.AutoLinearLayout>
