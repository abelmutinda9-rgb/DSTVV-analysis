<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mLayoutNation"
    android:background="@drawable/selector_item_nation"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="48px">
    <ImageView
        android:id="@+id/mImageSelected"
        android:layout_width="20px"
        android:layout_height="15px"
        android:layout_marginLeft="20px"
        android:src="@drawable/icon_nation_selected"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="28px"
        android:textColor="@color/color_333333"
        android:ellipsize="marquee"
        android:gravity="center"
        android:id="@+id/mTextNation"
        android:layout_width="220px"
        android:layout_height="match_parent"
        android:layout_marginLeft="50px"
        android:text="Armenia"
        android:singleLine="true"
        android:marqueeRepeatLimit="marquee_forever"/>
    <TextView
        android:textSize="28px"
        android:textColor="@color/color_333333"
        android:gravity="center"
        android:id="@+id/mTextNationCode"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginRight="20px"
        android:text="+374"
        android:singleLine="true"
        android:layout_alignParentRight="true"/>
</com.zhy.autolayout.AutoRelativeLayout>
