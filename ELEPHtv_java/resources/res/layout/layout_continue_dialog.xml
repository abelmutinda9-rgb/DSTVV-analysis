<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/bg_play_continue_pop"
    android:padding="30dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:orientation="vertical"
        android:layout_width="320dp"
        android:layout_height="120dp">
        <TextView
            android:textSize="18dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/tv_play_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/start_from"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_alignParentBottom="true">
            <Button
                android:textSize="16dp"
                android:textColor="#ffffff"
                android:id="@+id/btn_toPlay"
                android:background="@drawable/selector_to_play"
                android:layout_width="130dp"
                android:layout_height="50dp"
                android:text="@string/replay"/>
            <Button
                android:textSize="16dp"
                android:textColor="#ffffff"
                android:id="@+id/btn_play_continue"
                android:background="@drawable/selector_to_play"
                android:layout_width="130dp"
                android:layout_height="50dp"
                android:layout_marginLeft="40dp"
                android:text="@string/play_continue"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
