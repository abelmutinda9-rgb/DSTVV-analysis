<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_match_detail"
    android:clipChildren="true"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.open.leanback.widget.VerticalGridView
        android:id="@+id/mRvMatch"
        android:background="@color/color_990f0f0f"
        android:paddingTop="90px"
        android:paddingBottom="90px"
        android:layout_width="380px"
        android:layout_height="match_parent"/>
    <com.widget.recyclerView.RecyclerViewTV
        android:scrollbarSize="4px"
        android:scrollbarThumbVertical="@drawable/scrollbar_thumb_match_rank_vertical"
        android:scrollbarTrackVertical="@drawable/scrollbar_track_vertical"
        android:scrollbarAlwaysDrawVerticalTrack="true"
        android:scrollbarStyle="outsideOverlay"
        android:id="@+id/mRvMatchSchedule"
        android:paddingLeft="60px"
        android:paddingTop="8px"
        android:scrollbars="vertical"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="380px"
        android:layout_marginTop="82px"/>
    <com.zhy.autolayout.AutoLinearLayout
        android:orientation="vertical"
        android:id="@+id/mLlNoInternet"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="440px"
        android:layout_marginTop="373px"
        android:layout_marginRight="87px">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="175px"
            android:src="@drawable/match_no_internet_icon"/>
        <TextView
            android:textSize="24px"
            android:textColor="@color/color_font_normal"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13px"
            android:text="@string/match_no_internet"/>
    </com.zhy.autolayout.AutoLinearLayout>
    <com.zhy.autolayout.AutoLinearLayout
        android:orientation="vertical"
        android:id="@+id/mLlNoSchedule"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="440px"
        android:layout_marginTop="373px"
        android:layout_marginRight="87px">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="175px"
            android:src="@drawable/match_no_schedule_icon"/>
        <TextView
            android:textSize="24px"
            android:textColor="@color/color_font_normal"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13px"
            android:text="@string/match_no_schedule"/>
    </com.zhy.autolayout.AutoLinearLayout>
    <com.module.view.LoadingView
        android:layout_gravity="center"
        android:id="@+id/mLoadingView"
        android:visibility="gone"
        android:layout_width="280px"
        android:layout_height="280px"/>
</com.zhy.autolayout.AutoFrameLayout>
