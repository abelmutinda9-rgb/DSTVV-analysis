<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mLayoutNation"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="80px">
    <ImageView
        android:id="@+id/mImageView"
        android:layout_width="44px"
        android:layout_height="44px"
        android:layout_marginLeft="20px"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="28px"
        android:textColor="@color/color_1E1E1F"
        android:ellipsize="marquee"
        android:gravity="center"
        android:id="@+id/mTextNation"
        android:layout_width="220px"
        android:layout_height="match_parent"
        android:layout_marginLeft="50px"
        android:text="Armenia"
        android:singleLine="true"
        android:layout_toRightOf="@+id/mImageView"
        android:marqueeRepeatLimit="marquee_forever"/>
    <ImageView
        android:id="@+id/mImageSelected"
        android:background="@mipmap/icon_acount_check"
        android:layout_width="20px"
        android:layout_height="20px"
        android:layout_marginRight="30px"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
</com.zhy.autolayout.AutoRelativeLayout>
