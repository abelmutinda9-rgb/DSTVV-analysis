<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout
        android:orientation="vertical"
        android:id="@+id/ll_date"
        android:background="@color/color_e6000000"
        android:layout_width="107dp"
        android:layout_height="match_parent">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/mIvUp"
            android:layout_width="21dp"
            android:layout_height="12dp"
            android:layout_marginTop="35dp"
            android:src="@drawable/image_up"/>
        <com.widget.custom.MemoryListView
            android:layout_gravity="center_horizontal"
            android:id="@+id/mMlvDate"
            android:scrollbars="none"
            android:layout_width="73dp"
            android:layout_height="match_parent"
            android:layout_marginTop="67dp"
            android:layout_marginBottom="67dp"
            android:listSelector="@drawable/selector_live_date"
            android:divider="@null"
            android:dividerHeight="13dp"/>
        <ImageView
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/mIvDown"
            android:layout_width="21dp"
            android:layout_height="12dp"
            android:layout_marginBottom="35dp"
            android:src="@drawable/image_down"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/mLayoutList"
        android:background="@color/color_cc000000"
        android:layout_width="360dp"
        android:layout_height="match_parent">
        <com.module.view.AutoFocusedTextView
            android:textSize="21sp"
            android:textColor="@color/color_c4c4c4"
            android:ellipsize="marquee"
            android:gravity="center_vertical"
            android:id="@+id/mTvChannel"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginLeft="12dp"
            android:text="Fox Sports HD"
            android:singleLine="true"
            android:marqueeRepeatLimit="marquee_forever"/>
        <View
            android:id="@+id/mVLine"
            android:background="@color/color_66ffffff"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="60dp"/>
        <com.widget.custom.MemoryListView
            android:id="@+id/mMlvEpg"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="603dp"
            android:layout_marginTop="61dp"
            android:listSelector="@drawable/selector_live_select"
            android:cacheColorHint="@android:color/transparent"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp"/>
        <TextView
            android:textSize="19sp"
            android:textColor="@color/color_c4c4c4"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/mTvLoading"
            android:paddingLeft="31dp"
            android:paddingRight="31dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:id="@+id/mVBottomLine"
            android:background="@color/color_66ffffff"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="664dp"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/color_ff9500"
            android:id="@+id/tvEpgTips"
            android:paddingTop="7dp"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="665dp"
            android:layout_marginRight="13dp"
            android:text="@string/epg_ok_tips"/>
    </FrameLayout>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/llEpgDes"
        android:background="@color/color_cc000000"
        android:visibility="gone"
        android:layout_width="253dp"
        android:layout_height="267dp"
        android:layout_marginLeft="3dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_c4c4c4"
            android:ellipsize="end"
            android:id="@+id/tvEpgTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="7dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="13dp"
            android:singleLine="true"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/color_c4c4c4"
            android:id="@+id/tvEpgDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="7dp"
            android:layout_marginTop="3dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_858c94"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="7dp"
            android:layout_marginTop="8dp"
            android:text="@string/description"/>
        <com.swlauthnew.view.ScrollTextView
            android:textSize="16sp"
            android:textColor="@color/color_c4c4c4"
            android:id="@+id/tvEpgDes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="7dp"
            android:layout_marginTop="3dp"
            android:layout_marginRight="3dp"
            android:layout_marginBottom="13dp"/>
    </LinearLayout>
</merge>
