<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/selector_vod_bg_message_item"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="560px"
    android:layout_height="180px">
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_f5f5f5"
        android:id="@+id/mTextMessageTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="18px"
        android:layout_marginTop="10px"
        android:text="111"
        android:singleLine="true"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_f5f5f5"
        android:ellipsize="marquee"
        android:id="@+id/mTextMessageContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="18px"
        android:layout_marginTop="65px"
        android:layout_marginRight="18px"
        android:text="222"
        android:scrollHorizontally="true"
        android:singleLine="true"
        android:marqueeRepeatLimit="marquee_forever"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/color_a8a8a8"
        android:id="@+id/mTextMessageTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="18px"
        android:layout_marginBottom="16px"
        android:text="2018-12-14"
        android:layout_alignParentBottom="true"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/color_ffaa00"
        android:id="@+id/mTextMoreHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="19px"
        android:layout_marginBottom="15px"
        android:text="[OK] more&gt;"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"/>
    <ImageView
        android:id="@+id/mIvStatus"
        android:layout_width="77px"
        android:layout_height="77px"
        android:layout_marginTop="9px"
        android:layout_marginRight="10px"
        android:src="@mipmap/bg_message_read_flag"
        android:scaleType="fitXY"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"/>
</com.zhy.autolayout.AutoRelativeLayout>
