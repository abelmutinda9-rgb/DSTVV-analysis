<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_tigre"
    android:paddingTop="14dp"
    android:layout_width="613dp"
    android:layout_height="360dp">
    <TextView
        android:textSize="23dp"
        android:textColor="@color/color_ceddf3"
        android:gravity="center"
        android:id="@+id/mTextTitle"
        android:paddingLeft="35dp"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="53dp"
        android:text=""
        android:singleLine="true"/>
    <com.swlauthnew.view.CustomTextView
        android:textSize="23dp"
        android:textColor="@color/color_ffffff"
        android:gravity="center"
        android:id="@+id/mTextTitleSuc"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="30dp"
        android:text=""
        android:singleLine="true"
        style="@style/marquee_textview"/>
    <TextView
        android:textSize="23dp"
        android:textColor="@color/color_ceddf3"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/mTextShowCode"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="77dp"
        android:text="2514-5874-6587-2541"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/mLayoutActiving"
        android:visibility="gone"
        android:layout_width="347dp"
        android:layout_height="45dp"
        android:layout_marginTop="100dp">
        <TextView
            android:textSize="23dp"
            android:textColor="@color/color_0082ff"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/activing_new"/>
        <ImageView
            android:layout_gravity="bottom"
            android:id="@+id/mImageActiving"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginBottom="11dp"
            android:src="@drawable/icon_activing3"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/mLayoutExit"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="19dp"
            android:textColor="@color/color_ceddf3"
            android:gravity="center_vertical"
            android:layout_gravity="center_horizontal"
            android:id="@+id/mTextTips"
            android:layout_width="547dp"
            android:layout_height="127dp"
            android:text="激活成功！15分钟后生效，您的应用可继续观看365天。"/>
        <Button
            android:textSize="19dp"
            android:textColor="@color/color_ceddf3"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/mButtonExit"
            android:background="@drawable/bg_btn_tigre_selector"
            android:layout_width="133dp"
            android:layout_height="45dp"
            android:layout_marginBottom="67dp"
            android:text="@string/exit_new"/>
    </LinearLayout>
    <TextView
        android:textSize="19dp"
        android:textColor="@color/color_ceddf3"
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:id="@+id/mTextTipsFail"
        android:layout_width="547dp"
        android:layout_height="127dp"
        android:text="激活无效！您的应用不符合使用条件，请检查激活码是否输入正确，如有疑问请联系购买激活码处。"/>
    <RelativeLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/rlConfirm"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp">
        <com.swlauthnew.view.ScrollTextView
            android:textSize="19dp"
            android:textColor="@color/color_ffffff"
            android:gravity="left"
            android:layout_gravity="center"
            android:id="@+id/mTextTipsSuc"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:layout_width="wrap_content"
            android:layout_height="160dp"
            android:text=""
            android:lineSpacingExtra="10dp"/>
    </RelativeLayout>
    <Button
        android:textSize="19dp"
        android:textColor="@color/color_ffffff"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/mButtonExitSuc"
        android:background="@drawable/bg_btn_selector"
        android:visibility="gone"
        android:layout_width="147dp"
        android:layout_height="45dp"
        android:text="@string/exit_new"/>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/mLayoutReConfirm"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="67dp">
        <Button
            android:textSize="19dp"
            android:textColor="@color/color_ceddf3"
            android:gravity="center"
            android:id="@+id/mButtonReEnter"
            android:background="@drawable/bg_btn_tigre_selector"
            android:layout_width="147dp"
            android:layout_height="45dp"
            android:text="@string/button_re_enter_new"/>
        <Button
            android:textSize="19dp"
            android:textColor="@color/color_ceddf3"
            android:gravity="center"
            android:id="@+id/mButtonExitFail"
            android:background="@drawable/bg_btn_tigre_selector"
            android:layout_width="147dp"
            android:layout_height="45dp"
            android:layout_marginLeft="67dp"
            android:text="@string/exit_new"/>
    </LinearLayout>
</LinearLayout>
