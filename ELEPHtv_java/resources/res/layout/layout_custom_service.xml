<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/flServer"
    android:background="@drawable/sel_poster_nohalo"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mServerList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.module.view.LoadingView
        android:layout_gravity="center"
        android:id="@+id/loading"
        android:layout_width="280px"
        android:layout_height="280px"/>
</com.zhy.autolayout.AutoFrameLayout>
