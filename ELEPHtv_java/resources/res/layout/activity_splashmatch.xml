<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="32dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="@string/module_name"/>
    <com.zhy.autolayout.AutoLinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/mLlFunction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <Button
            android:id="@+id/mBtnCategory"
            android:background="@drawable/selector_dialog_btn_watch"
            android:layout_width="200dp"
            android:layout_height="50dp"
            android:text="MatchCategory"
            android:textAllCaps="false"/>
        <Button
            android:id="@+id/mBtnRank"
            android:background="@drawable/selector_dialog_btn_account"
            android:layout_width="200dp"
            android:layout_height="50dp"
            android:layout_marginTop="50dp"
            android:text="MatchRank"
            android:textAllCaps="false"/>
        <Button
            android:id="@+id/mBtnSchedule"
            android:background="@drawable/selector_dialog_btn_account"
            android:layout_width="200dp"
            android:layout_height="50dp"
            android:layout_marginTop="50dp"
            android:text="MatchSchedule"
            android:textAllCaps="false"/>
    </com.zhy.autolayout.AutoLinearLayout>
</com.zhy.autolayout.AutoFrameLayout>
