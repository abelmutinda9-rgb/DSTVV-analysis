<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/base_dialog_root_view"
    android:layout_width="660px"
    android:layout_height="430px">
    <com.zhy.autolayout.AutoRelativeLayout
        android:layout_gravity="center"
        android:background="@drawable/bg_dialog_brasiliptv"
        android:layout_width="660px"
        android:layout_height="430px">
        <TextView
            android:textSize="28px"
            android:textColor="@android:color/white"
            android:gravity="center_horizontal"
            android:id="@+id/layout_double_dialog_msg_tv"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="100px"
            android:layout_centerHorizontal="true"/>
        <com.zhy.autolayout.AutoLinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="70px"
            android:layout_below="@+id/layout_double_dialog_msg_tv"
            android:layout_centerHorizontal="true">
            <Button
                android:textSize="32px"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/layout_double_dialog_positive_btn"
                android:background="@drawable/selector_dialog_btn_account"
                android:layout_width="420px"
                android:layout_height="58px"
                android:singleLine="true"/>
            <Button
                android:textSize="32px"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/layout_double_dialog_negative_btn"
                android:background="@drawable/selector_dialog_btn_account"
                android:layout_width="420px"
                android:layout_height="58px"
                android:layout_marginTop="15px"
                android:singleLine="true"/>
        </com.zhy.autolayout.AutoLinearLayout>
    </com.zhy.autolayout.AutoRelativeLayout>
</com.zhy.autolayout.AutoRelativeLayout>
