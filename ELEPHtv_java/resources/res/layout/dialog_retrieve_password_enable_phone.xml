<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.zhy.autolayout.AutoRelativeLayout
        android:orientation="vertical"
        android:id="@+id/mLlWrapper"
        android:background="@drawable/bg_dialog_brasiliptv"
        android:layout_width="980px"
        android:layout_height="580px">
        <TextView
            android:textSize="20sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/mDialogTitle"
            android:background="@drawable/dialog_title_bg"
            android:layout_width="match_parent"
            android:layout_height="100px"
            android:text="@string/personal_retrieve_through_email"/>
        <com.zhy.autolayout.AutoLinearLayout
            android:orientation="vertical"
            android:id="@+id/mLayoutInputEmail"
            android:visibility="visible"
            android:layout_width="980px"
            android:layout_height="580px"
            android:layout_below="@+id/mDialogTitle">
            <TextView
                android:textSize="28px"
                android:textColor="@color/color_ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="80px"
                android:layout_marginTop="120px"
                android:text="@string/personal_new_email"/>
            <EditText
                android:id="@+id/mEditEmail"
                android:layout_marginLeft="80px"
                android:layout_marginTop="5px"
                android:hint="@string/account_input_email_hint"
                android:inputType="textEmailAddress"
                style="@style/edit_dialog_style"/>
        </com.zhy.autolayout.AutoLinearLayout>
        <com.zhy.autolayout.AutoLinearLayout
            android:orientation="vertical"
            android:id="@+id/mLayoutVerifyEmail"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="80px"
            android:layout_below="@+id/mDialogTitle">
            <TextView
                android:textSize="32px"
                android:textColor="@color/color_bbc0c4"
                android:id="@+id/mTextEmailVerify"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="75px"
                android:layout_marginRight="75px"
                android:text="@string/personal_email_retrieve_tip"/>
        </com.zhy.autolayout.AutoLinearLayout>
        <Button
            android:id="@+id/mBtnConfirm"
            android:layout_marginBottom="60px"
            android:text="@string/personal_send_email"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            style="@style/button_single_style"/>
    </com.zhy.autolayout.AutoRelativeLayout>
    <com.module.view.DialogBottomBar
        android:id="@+id/mBottomBar"
        android:visibility="gone"
        android:layout_width="980px"
        android:layout_height="wrap_content"
        android:layout_below="@+id/mLlWrapper"/>
    <com.module.view.LoadingView
        android:id="@+id/mLoadingView"
        android:visibility="gone"
        android:layout_width="180px"
        android:layout_height="180px"
        android:layout_centerInParent="true"/>
</com.zhy.autolayout.AutoRelativeLayout>
