<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:focusable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="167dp"
    android:layout_height="148dp">
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/mPosterLayout"
        android:background="@drawable/sel_poster"
        android:duplicateParentState="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="167dp"
        android:layout_height="109dp">
        <ImageView
            android:id="@+id/mPosterImg"
            android:background="@color/color_1affffff"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@mipmap/icon_live_free_placeholder"
            android:scaleType="fitXY"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/mPosterMore"
            android:background="@mipmap/icon_home_free_more"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="21sp"
        android:textColor="@color/sel_text_color_white"
        android:gravity="center"
        android:id="@+id/mVideoNameText"
        android:visibility="visible"
        android:duplicateParentState="true"
        android:layout_width="167dp"
        android:layout_height="39dp"
        android:layout_below="@+id/mPosterLayout"
        android:layout_centerHorizontal="true"
        style="@style/marqueeText"/>
</RelativeLayout>
