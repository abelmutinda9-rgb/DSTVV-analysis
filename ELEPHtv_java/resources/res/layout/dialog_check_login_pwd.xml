<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.zhy.autolayout.AutoFrameLayout
        android:background="@drawable/bg_dialog_brasiliptv"
        android:layout_width="980px"
        android:layout_height="540px">
        <com.zhy.autolayout.AutoLinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="40px"
                android:textColor="@color/color_ffffff"
                android:gravity="center"
                android:id="@+id/mDialogTitle"
                android:background="@drawable/dialog_title_bg"
                android:layout_width="match_parent"
                android:layout_height="100px"
                android:text="@string/login_password"/>
            <TextView
                android:textSize="28px"
                android:textColor="@color/color_ffffff"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="72px"
                android:layout_marginTop="70px"
                android:text="@string/personal_password"/>
            <EditText
                android:layout_gravity="center_horizontal"
                android:id="@+id/mEtInput"
                android:nextFocusDown="@+id/mButtonConfirm"
                android:layout_width="641px"
                android:layout_marginTop="43px"
                android:hint="@string/loing_password_hint"
                style="@style/edit_dialog_style"/>
            <TextView
                android:textSize="24px"
                android:textColor="@color/text_color"
                android:gravity="center"
                android:layout_gravity="right"
                android:id="@+id/mTvForget"
                android:background="@drawable/selector_base_text_bg"
                android:paddingLeft="10px"
                android:paddingRight="10px"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="17px"
                android:layout_marginRight="170px"
                android:text="@string/adult_forgot_pwd"/>
            <com.zhy.autolayout.AutoLinearLayout
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="54px">
                <Button
                    android:id="@+id/mButtonConfirm"
                    android:nextFocusUp="@+id/mTvForget"
                    android:layout_width="380px"
                    android:layout_height="68px"
                    android:text="@string/pwd_confim"
                    style="@style/btn_pwd"/>
                <Button
                    android:id="@+id/mButtonCancel"
                    android:nextFocusUp="@+id/mTvForget"
                    android:layout_width="380px"
                    android:layout_height="68px"
                    android:layout_marginLeft="60px"
                    android:text="@string/pwd_cancel"
                    style="@style/btn_pwd"/>
            </com.zhy.autolayout.AutoLinearLayout>
        </com.zhy.autolayout.AutoLinearLayout>
        <com.module.view.LoadingView
            android:layout_gravity="center"
            android:id="@+id/mLoadingView"
            android:visibility="gone"
            android:layout_width="180px"
            android:layout_height="180px"/>
    </com.zhy.autolayout.AutoFrameLayout>
    <com.module.view.DialogBottomBar
        android:id="@+id/mBottomBar"
        android:visibility="gone"
        android:layout_width="980px"
        android:layout_height="wrap_content"
        android:layout_below="@+id/mLayoutBind"/>
</com.zhy.autolayout.AutoLinearLayout>
