<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="40px"
        android:textStyle="bold"
        android:textColor="@color/color_font_main"
        android:layout_gravity="center_horizontal"
        android:id="@+id/mTvDetailType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="120px"/>
    <ScrollView
        android:scrollbarSize="10px"
        android:scrollbarThumbVertical="@drawable/shape_scrollbar_gray_thumb"
        android:scrollbarTrackVertical="@drawable/shape_scrollbar_gray_track"
        android:scrollbarStyle="outsideInset"
        android:id="@+id/mScrollView"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="88px"
        android:layout_marginTop="40px"
        android:layout_marginRight="53px"
        android:layout_marginBottom="60px"
        android:layout_weight="1"
        android:scrollbarFadeDuration="0"
        android:fadeScrollbars="false">
        <TextView
            android:textSize="28px"
            android:textColor="@color/color_font_normal"
            android:id="@+id/mTextContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="12px"/>
    </ScrollView>
</com.zhy.autolayout.AutoLinearLayout>
