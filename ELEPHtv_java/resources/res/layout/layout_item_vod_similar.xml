<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/mLayoutProgram"
    android:focusable="true"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.zhy.autolayout.AutoFrameLayout
        android:background="@drawable/sel_poster_nohalo"
        android:duplicateParentState="true"
        android:layout_width="210px"
        android:layout_height="308px">
        <ImageView
            android:id="@+id/mImgPoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"/>
        <TextView
            android:textSize="24px"
            android:textColor="@color/color_ffffffff"
            android:gravity="bottom|right"
            android:layout_gravity="bottom"
            android:id="@+id/mTextUpdate"
            android:background="@drawable/shape_bg_series_update"
            android:paddingRight="5px"
            android:paddingBottom="5px"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="50px"
            style="@style/marqueeText"/>
        <ImageView
            android:layout_gravity="top|right"
            android:id="@+id/mImgTsTag"
            android:background="@mipmap/vod_icon_tag_ts"
            android:visibility="gone"
            android:layout_width="51px"
            android:layout_height="52px"/>
        <ImageView
            android:layout_gravity="top|right"
            android:id="@+id/mImg4kTag"
            android:background="@mipmap/vod_icon_tag_4k"
            android:visibility="gone"
            android:layout_width="58px"
            android:layout_height="36px"/>
        <ImageView
            android:layout_gravity="bottom|right"
            android:id="@+id/mImgSubtitleTag"
            android:background="@mipmap/vod_icon_tag_subtitle"
            android:visibility="gone"
            android:layout_width="38px"
            android:layout_height="28px"/>
        <TextView
            android:textSize="24px"
            android:textStyle="bold"
            android:textColor="@color/color_ff8300"
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/mTextScore"
            android:background="@mipmap/vod_icon_tag_score_bg"
            android:visibility="gone"
            android:layout_width="48px"
            android:layout_height="28px"
            android:includeFontPadding="false"/>
    </com.zhy.autolayout.AutoFrameLayout>
    <TextView
        android:textSize="28px"
        android:textColor="@color/color_font_normal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/mTextName"
        android:padding="5px"
        android:layout_width="210px"
        android:layout_height="wrap_content"
        style="@style/marqueeText"/>
</com.zhy.autolayout.AutoLinearLayout>
