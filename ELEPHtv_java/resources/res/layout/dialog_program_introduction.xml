<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="58px"
        android:textStyle="bold"
        android:textColor="@color/color_font_main"
        android:id="@+id/mTvName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="165px"/>
    <com.zhy.autolayout.AutoLinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20px">
        <com.module.childlock.view.MarqueTextView
            android:textSize="28px"
            android:textStyle="bold"
            android:textColor="@color/color_font_normal"
            android:layout_gravity="center_vertical"
            android:id="@+id/mTextTimeType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="30px"
            android:maxWidth="1200px"
            android:singleLine="false"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/mIvSupportSubtitle"
            android:visibility="gone"
            android:layout_width="39px"
            android:layout_height="28px"
            android:layout_marginLeft="10px"
            android:src="@mipmap/icon_support_subtitles"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/mIvSupportAudio"
            android:visibility="gone"
            android:layout_width="39px"
            android:layout_height="28px"
            android:layout_marginLeft="10px"
            android:src="@mipmap/icon_support_audio"/>
        <TextView
            android:textSize="32px"
            android:textStyle="bold"
            android:textColor="@color/color_font_height_light"
            android:layout_gravity="center_vertical"
            android:id="@+id/mTextScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20px"/>
    </com.zhy.autolayout.AutoLinearLayout>
    <com.zhy.autolayout.AutoLinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15px">
        <TextView
            android:textSize="28px"
            android:textStyle="bold"
            android:textColor="@color/color_detail_font_des"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="660px"
            android:text="@string/detail_director"
            android:singleLine="true"/>
        <com.module.childlock.view.MarqueTextView
            android:textSize="28px"
            android:textColor="@color/color_font_normal"
            android:id="@+id/mTextDirector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="1325px"
            android:singleLine="false"/>
    </com.zhy.autolayout.AutoLinearLayout>
    <com.zhy.autolayout.AutoLinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15px">
        <TextView
            android:textSize="28px"
            android:textStyle="bold"
            android:textColor="@color/color_detail_font_des"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="660px"
            android:text="@string/detail_actor"
            android:singleLine="false"/>
        <TextView
            android:textSize="28px"
            android:textColor="@color/color_font_normal"
            android:id="@+id/mTextActor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="1325px"/>
    </com.zhy.autolayout.AutoLinearLayout>
    <ScrollView
        android:id="@+id/mScrollView"
        android:layout_width="1400px"
        android:layout_height="460px"
        android:layout_marginTop="50px">
        <com.zhy.autolayout.AutoFrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="28px"
                android:textColor="@color/color_detail_font_des"
                android:id="@+id/mTextContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="10px"/>
            <TextView
                android:textSize="28px"
                android:textStyle="bold"
                android:textColor="@color/color_detail_font_des"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="660px"
                android:text="@string/detail_introduction"
                android:singleLine="true"/>
        </com.zhy.autolayout.AutoFrameLayout>
    </ScrollView>
</com.zhy.autolayout.AutoLinearLayout>
