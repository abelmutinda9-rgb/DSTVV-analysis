<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@mipmap/vod_category_left_bg"
    android:visibility="visible"
    android:layout_width="320px"
    android:layout_height="match_parent">
    <com.zhy.autolayout.AutoLinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/mLlSearch"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="270px">
        <ImageView
            android:background="@drawable/selector_notification"
            android:duplicateParentState="true"
            android:layout_width="100px"
            android:layout_height="100px"
            android:src="@drawable/bg_bl_search"/>
        <TextView
            android:textSize="24px"
            android:textColor="@color/color_b3b3b3"
            android:gravity="center"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20px"
            android:text="@string/bl_search_input_hint"
            android:includeFontPadding="false"/>
    </com.zhy.autolayout.AutoLinearLayout>
    <View
        android:background="@color/color_66ffffff"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <com.open.leanback.widget.VerticalGridView
        android:id="@+id/mGridCategory"
        android:layout_width="320px"
        android:layout_height="match_parent"
        android:layout_marginTop="44px"
        android:verticalSpacing="10px"
        app:numberOfColumns="1"/>
</com.zhy.autolayout.AutoLinearLayout>
