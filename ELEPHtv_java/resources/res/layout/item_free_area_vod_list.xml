<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:focusable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="167dp"
    android:layout_height="300dp">
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/mPosterLayout"
        android:background="@drawable/sel_poster_nohalo"
        android:duplicateParentState="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/mPosterImg"
            android:layout_width="match_parent"
            android:layout_height="245dp"
            android:scaleType="fitXY"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="bottom|center_horizontal"
            android:id="@+id/mVideoStateText"
            android:background="@drawable/shape_bg_poster_title"
            android:paddingBottom="3dp"
            android:visibility="gone"
            android:layout_width="167dp"
            android:layout_height="53dp"
            android:layout_alignBottom="@+id/mPosterImg"
            style="@style/marqueeText"/>
        <RelativeLayout
            android:id="@+id/mLayoutMore"
            android:background="@mipmap/bg_vod_more"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="245dp"
            android:layout_centerInParent="true">
            <View
                android:background="@mipmap/icon_free_more"
                android:layout_width="65dp"
                android:layout_height="67dp"
                android:layout_marginTop="89dp"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="27dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="27dp"
                android:text="@string/more_info"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
    </RelativeLayout>
    <TextView
        android:textSize="21sp"
        android:textColor="@color/sel_text_color_white"
        android:gravity="center"
        android:id="@+id/mVideoNameText"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="3dp"
        android:layout_marginTop="7dp"
        android:layout_marginRight="3dp"
        android:layout_below="@+id/mPosterLayout"
        android:layout_centerHorizontal="true"
        style="@style/marqueeText"/>
</RelativeLayout>
