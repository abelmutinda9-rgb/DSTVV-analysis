<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="73dp">
    <FrameLayout
        android:id="@+id/mRlChannelIcon"
        android:layout_width="73dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp">
        <ImageView
            android:gravity="center"
            android:id="@+id/mIvChannelIcon"
            android:layout_width="60dp"
            android:layout_height="40dp"
            android:scaleType="fitXY"/>
        <ImageView
            android:layout_gravity="right"
            android:id="@+id/ivOwnSource"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginTop="31dp"
            android:layout_marginRight="7dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/mRlNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="10dp"
        android:layout_toRightOf="@+id/mRlChannelIcon">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/mIvPlay"
            android:visibility="gone"
            android:layout_width="17dp"
            android:layout_height="20dp"
            android:layout_marginTop="4dp"
            android:scaleType="fitXY"/>
        <TextView
            android:textSize="27sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/mTvNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:includeFontPadding="false"/>
    </FrameLayout>
    <TextView
        android:textSize="13sp"
        android:ellipsize="marquee"
        android:gravity="center"
        android:id="@+id/mTvCurrentEpg"
        android:layout_width="233dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="2dp"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:layout_toRightOf="@+id/mRlChannelIcon"
        android:layout_below="@+id/mTvChannelName"
        android:marqueeRepeatLimit="marquee_forever"/>
    <ImageView
        android:id="@+id/mIvLock"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:layout_marginRight="7dp"
        android:layout_toLeftOf="@+id/mIvFav"/>
    <ImageView
        android:id="@+id/mIvFav"
        android:background="@drawable/live_channel_fav"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="19dp"
        android:layout_marginRight="7dp"
        android:layout_toLeftOf="@+id/mIvBack"/>
    <ImageView
        android:id="@+id/mIvBack"
        android:background="@drawable/live_channel_back"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:layout_marginRight="13dp"
        android:layout_alignParentRight="true"/>
    <TextView
        android:textSize="27sp"
        android:textStyle="bold"
        android:ellipsize="marquee"
        android:id="@+id/mTvChannelName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="10dp"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:layout_toLeftOf="@+id/mIvLock"
        android:layout_toRightOf="@+id/mRlNumber"
        android:marqueeRepeatLimit="marquee_forever"/>
</RelativeLayout>
