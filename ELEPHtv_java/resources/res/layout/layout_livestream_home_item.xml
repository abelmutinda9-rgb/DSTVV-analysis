<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mConstraintLiveStream"
    android:background="@drawable/sel_livestream_item_home"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="250dp"
    android:layout_height="144dp">
    <ImageView
        android:id="@+id/mImgLiveStream"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"/>
    <View
        android:id="@+id/mViewLiveStream"
        android:background="@color/color_66000000"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <TextView
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/mTvLiveStream"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="@+id/mViewLiveStream"/>
</androidx.constraintlayout.widget.ConstraintLayout>
