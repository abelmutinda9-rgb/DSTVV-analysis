<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/mLayoutPasswordInput"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.zhy.autolayout.AutoLinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_dialog_brasiliptv"
        android:layout_width="980px"
        android:layout_height="620px">
        <TextView
            android:textSize="36px"
            android:textColor="@color/color_ffffff"
            android:gravity="center"
            android:id="@+id/mDialogTitle"
            android:background="@drawable/dialog_title_bg"
            android:layout_width="match_parent"
            android:layout_height="100px"
            android:text="@string/child_lock"/>
        <TextView
            android:textSize="28px"
            android:textColor="@color/color_ffffff"
            android:gravity="center"
            android:id="@+id/mTvPwd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="72px"
            android:layout_marginTop="70px"
            android:text="@string/personal_password"/>
        <TextView
            android:textSize="28px"
            android:textColor="@color/color_ffffff"
            android:id="@+id/mTvOpenLiveAdult"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="60px"
            android:layout_marginTop="38px"
            android:layout_marginRight="60px"
            android:text="@string/adult_need_pwd_to_show_live"/>
        <com.zhy.autolayout.AutoLinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/mLayoutEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="45px">
            <EditText
                android:id="@+id/mEditPasswordFirst"
                android:nextFocusDown="@+id/mButtonConfirm"
                style="@style/et_input_pwd_set"/>
            <View
                android:background="@color/color_949ca8"
                android:layout_width="25px"
                android:layout_height="4px"
                android:layout_marginLeft="24px"
                android:layout_marginRight="24px"/>
            <EditText
                android:id="@+id/mEditPasswordSecond"
                android:nextFocusDown="@+id/mButtonConfirm"
                style="@style/et_input_pwd_set"/>
            <View
                android:background="@color/color_949ca8"
                android:layout_width="25px"
                android:layout_height="4px"
                android:layout_marginLeft="24px"
                android:layout_marginRight="24px"/>
            <EditText
                android:id="@+id/mEditPasswordThird"
                android:nextFocusDown="@+id/mButtonConfirm"
                style="@style/et_input_pwd_set"/>
            <View
                android:background="@color/color_949ca8"
                android:layout_width="25px"
                android:layout_height="4px"
                android:layout_marginLeft="24px"
                android:layout_marginRight="24px"/>
            <EditText
                android:id="@+id/mEditPasswordFourth"
                android:nextFocusDown="@+id/mButtonConfirm"
                style="@style/et_input_pwd_set"/>
        </com.zhy.autolayout.AutoLinearLayout>
        <com.zhy.autolayout.AutoLinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="80px">
            <TextView
                android:textSize="28px"
                android:id="@+id/mButtonConfirm"
                android:focusable="true"
                android:nextFocusUp="@+id/mEditPasswordFirst"
                android:layout_width="368px"
                android:layout_height="80px"
                android:text="@string/pwd_confim"
                style="@style/button_single_style"/>
            <TextView
                android:textSize="28px"
                android:id="@+id/mButtonCancel"
                android:focusable="true"
                android:nextFocusRight="@+id/mButtonCancel"
                android:layout_width="368px"
                android:layout_height="80px"
                android:layout_marginLeft="60px"
                android:text="@string/pwd_cancel"
                style="@style/button_single_style"/>
        </com.zhy.autolayout.AutoLinearLayout>
        <TextView
            android:textSize="24px"
            android:textColor="@color/text_color"
            android:layout_gravity="right"
            android:id="@+id/tvForget"
            android:background="@drawable/selector_base_text_bg"
            android:paddingLeft="10px"
            android:paddingTop="4px"
            android:paddingRight="10px"
            android:paddingBottom="4px"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="75px"
            android:layout_marginRight="70px"
            android:text="@string/adult_forgot_child_pwd"/>
    </com.zhy.autolayout.AutoLinearLayout>
    <com.module.view.DialogBottomBar
        android:id="@+id/mBottomBar"
        android:visibility="gone"
        android:layout_width="980px"
        android:layout_height="wrap_content"
        android:layout_below="@+id/mLayoutBind"/>
    <com.module.view.LoadingView
        android:layout_gravity="center"
        android:id="@+id/mLoadingView"
        android:visibility="gone"
        android:layout_width="180px"
        android:layout_height="180px"
        android:layout_marginTop="-310px"/>
</com.zhy.autolayout.AutoLinearLayout>
