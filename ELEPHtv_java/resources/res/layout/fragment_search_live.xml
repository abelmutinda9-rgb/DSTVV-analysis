<?xml version="1.0" encoding="utf-8"?>
<com.common.utils.mark.live.SearchLiveRootView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/mRootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/layout_search_keyboard"/>
    <RelativeLayout
        android:id="@+id/mLayoutResult"
        android:background="@color/color_cc090c1c"
        android:visibility="gone"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:alpha="0.8">
        <TextView
            android:textSize="21sp"
            android:textColor="@color/color_b3b6b6"
            android:ellipsize="marquee"
            android:id="@+id/chListTitle"
            android:paddingLeft="14dp"
            android:paddingTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/live_search_search_result"
            android:singleLine="true"/>
        <View
            android:background="@drawable/bg_search_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="60dp"/>
        <com.widget.recyclerView.RecyclerViewTV
            android:id="@+id/mRecyclerResult"
            android:visibility="visible"
            android:descendantFocusability="afterDescendants"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="61dp"
            android:layout_marginBottom="20dp"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/mLayoutFeedBack"
        android:background="@color/color_cc090c1c"
        android:visibility="gone"
        android:layout_width="354dp"
        android:layout_height="match_parent"
        android:alpha="0.8">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/mQrFeedBack"
            android:background="@color/color_ffffffff"
            android:layout_width="213dp"
            android:layout_height="213dp"
            android:layout_marginTop="253dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_ffffffff"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="21dp"
            android:text="@string/live_searcg_feedback_notice"/>
    </LinearLayout>
</com.common.utils.mark.live.SearchLiveRootView>
