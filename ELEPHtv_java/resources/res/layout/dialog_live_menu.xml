<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.zhy.autolayout.AutoLinearLayout
        android:orientation="vertical"
        android:background="@color/color_cc000000"
        android:layout_width="700px"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="32px"
            android:textColor="@color/color_ffffff"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="127px"
            android:layout_marginTop="46px"
            android:layout_marginRight="127px"
            android:text="@string/menu_des"/>
        <com.zhy.autolayout.AutoRelativeLayout
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="27px"
            android:layout_marginBottom="30px">
            <TextView
                android:textSize="50px"
                android:textColor="@color/color_ffffff"
                android:gravity="center"
                android:id="@+id/tvFav"
                android:background="@drawable/selector_menu_item_bg"
                android:focusable="true"
                android:layout_width="225px"
                android:layout_height="100px"
                android:text="@string/fav"/>
            <TextView
                android:textSize="50px"
                android:textColor="@color/color_ffffff"
                android:gravity="center"
                android:id="@+id/tvSort"
                android:background="@drawable/selector_menu_item_bg"
                android:focusable="true"
                android:layout_width="225px"
                android:layout_height="100px"
                android:layout_marginLeft="10px"
                android:text="@string/sort"
                android:layout_toRightOf="@+id/tvFav"/>
            <TextView
                android:textSize="50px"
                android:textColor="@color/color_ffffff"
                android:gravity="center"
                android:id="@+id/tvPrev"
                android:background="@drawable/selector_menu_item_bg"
                android:focusable="true"
                android:layout_width="225px"
                android:layout_height="100px"
                android:layout_marginTop="10px"
                android:text="@string/prev"
                android:layout_below="@+id/tvFav"
                android:layout_alignLeft="@+id/tvFav"/>
            <TextView
                android:textSize="50px"
                android:textColor="@color/color_ffffff"
                android:gravity="center"
                android:id="@+id/tvBlock"
                android:background="@drawable/selector_menu_item_bg"
                android:focusable="true"
                android:layout_width="225px"
                android:layout_height="100px"
                android:text="@string/block"
                android:layout_alignLeft="@+id/tvSort"
                android:layout_alignTop="@+id/tvPrev"/>
        </com.zhy.autolayout.AutoRelativeLayout>
    </com.zhy.autolayout.AutoLinearLayout>
</com.zhy.autolayout.AutoFrameLayout>
