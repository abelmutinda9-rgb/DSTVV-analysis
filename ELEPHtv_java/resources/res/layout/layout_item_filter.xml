<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/mLayoutProgram"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:background="@drawable/sel_poster_nohalo"
        android:duplicateParentState="true"
        android:layout_width="match_parent"
        android:layout_height="267dp">
        <ImageView
            android:id="@+id/mImgPoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/bg_placehoder"
            android:scaleType="fitXY"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_ffffffff"
            android:gravity="bottom|right"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/mTextUpdate"
            android:background="@drawable/shape_bg_series_update"
            android:paddingRight="3dp"
            android:paddingBottom="3dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="67dp"
            style="@style/marqueeText"/>
        <ImageView
            android:layout_gravity="right"
            android:id="@+id/mImgTsTag"
            android:background="@mipmap/vod_icon_tag_ts"
            android:visibility="gone"
            android:layout_width="34dp"
            android:layout_height="35dp"/>
        <ImageView
            android:layout_gravity="right"
            android:id="@+id/mImg4kTag"
            android:background="@mipmap/vod_icon_tag_4k"
            android:visibility="gone"
            android:layout_width="39dp"
            android:layout_height="24dp"/>
        <ImageView
            android:layout_gravity="bottom|right"
            android:id="@+id/mImgSubtitleTag"
            android:background="@mipmap/vod_icon_tag_subtitle"
            android:visibility="gone"
            android:layout_width="25dp"
            android:layout_height="19dp"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/color_ff8300"
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/mTextScore"
            android:background="@mipmap/vod_icon_tag_score_bg"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="19dp"
            android:includeFontPadding="false"/>
    </FrameLayout>
    <TextView
        android:textSize="21sp"
        android:textColor="@color/color_font_normal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/mTextName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="3dp"
        style="@style/marqueeText"/>
</LinearLayout>
