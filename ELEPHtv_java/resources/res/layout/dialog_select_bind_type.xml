<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zhy.autolayout.AutoLinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/mLayoutPassword"
        android:background="@drawable/bg_dialog_brasiliptv"
        android:layout_width="980px"
        android:layout_height="580px">
        <TextView
            android:textSize="40px"
            android:textColor="@color/color_ffffff"
            android:gravity="center"
            android:id="@+id/mDialogTitle"
            android:background="@drawable/dialog_title_bg"
            android:layout_width="match_parent"
            android:layout_height="100px"
            android:text="@string/bind_account"/>
        <TextView
            android:textSize="28px"
            android:textColor="@color/color_ffffff"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="107px"
            android:layout_marginTop="117px"
            android:layout_marginRight="107px"
            android:text="@string/bind_for_security"/>
        <com.zhy.autolayout.AutoLinearLayout
            android:gravity="bottom|center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.zhy.autolayout.AutoLinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/mLlBindPhone"
                android:background="@drawable/selector_bind_type_bg"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="340px"
                android:layout_height="128px"
                android:layout_marginBottom="60px">
                <ImageView
                    android:layout_width="64px"
                    android:layout_height="88px"
                    android:layout_marginLeft="29px"
                    android:src="@drawable/ic_retrieve_method_phone"/>
                <TextView
                    android:textSize="32px"
                    android:textColor="@color/color_ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="9px"
                    android:text="@string/bind_phone"/>
            </com.zhy.autolayout.AutoLinearLayout>
            <com.zhy.autolayout.AutoLinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/mLlBindEmail"
                android:background="@drawable/selector_bind_type_bg"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="340px"
                android:layout_height="128px"
                android:layout_marginLeft="80px"
                android:layout_marginBottom="60px">
                <ImageView
                    android:layout_width="80px"
                    android:layout_height="61px"
                    android:layout_marginLeft="30px"
                    android:src="@drawable/ic_retrieve_method_email"/>
                <TextView
                    android:textSize="32px"
                    android:textColor="@color/color_ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="9px"
                    android:text="@string/bind_email"/>
            </com.zhy.autolayout.AutoLinearLayout>
        </com.zhy.autolayout.AutoLinearLayout>
    </com.zhy.autolayout.AutoLinearLayout>
</com.zhy.autolayout.AutoFrameLayout>
