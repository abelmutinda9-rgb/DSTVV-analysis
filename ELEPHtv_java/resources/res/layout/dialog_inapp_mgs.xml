<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.zhy.autolayout.AutoRelativeLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/bg_dialog_brasiliptv"
        android:layout_width="980px"
        android:layout_height="600px">
        <TextView
            android:textSize="40px"
            android:textColor="@color/color_ffffff"
            android:gravity="center"
            android:id="@+id/mDialogTitle"
            android:background="@drawable/dialog_title_bg"
            android:layout_width="match_parent"
            android:layout_height="100px"
            android:text="@string/account_tips"/>
        <TextView
            android:textSize="32px"
            android:textColor="@color/color_bbc0c4"
            android:gravity="center_vertical"
            android:id="@+id/mDialogContent"
            android:layout_width="785px"
            android:layout_height="wrap_content"
            android:layout_above="@+id/mLayoutButtons"
            android:layout_below="@+id/mDialogTitle"
            android:layout_centerHorizontal="true"/>
        <Button
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/mLayoutButtons"
            android:layout_marginTop="30px"
            android:layout_marginBottom="60px"
            android:text="@string/confirm"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            style="@style/button_single_style"/>
    </com.zhy.autolayout.AutoRelativeLayout>
</com.zhy.autolayout.AutoLinearLayout>
