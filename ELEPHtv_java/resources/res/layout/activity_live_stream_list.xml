<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_0F0F0F"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zhy.autolayout.AutoLinearLayout
        android:orientation="vertical"
        android:id="@+id/mLayoutLiveStream"
        android:paddingLeft="60px"
        android:paddingRight="36px"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="43px">
        <TextView
            android:textSize="46px"
            android:textColor="@color/color_font_main"
            android:gravity="center"
            android:id="@+id/mTvChannelName"
            android:focusable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.open.leanback.widget.VerticalGridView
            android:id="@+id/rvLiveStreamList"
            android:focusable="false"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="18px"
            app:numberOfColumns="3"
            app:verticalMargin="20px"/>
    </com.zhy.autolayout.AutoLinearLayout>
</com.zhy.autolayout.AutoFrameLayout>
