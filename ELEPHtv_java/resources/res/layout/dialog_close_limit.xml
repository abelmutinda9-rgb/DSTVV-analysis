<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.zhy.autolayout.AutoLinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/bg_dialog_brasiliptv"
        android:layout_width="980px"
        android:layout_height="580px">
        <TextView
            android:textSize="40px"
            android:textColor="@color/color_ffffffff"
            android:gravity="center"
            android:background="@drawable/dialog_title_bg"
            android:layout_width="match_parent"
            android:layout_height="100px"
            android:text="@string/adult_live_channels"/>
        <TextView
            android:textSize="28px"
            android:textColor="@color/color_ffffffff"
            android:gravity="center_vertical"
            android:id="@+id/mTvTips1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="78px"
            android:layout_marginTop="36px"
            android:layout_marginRight="78px"
            android:text="@string/adult_sure_close_tip_1"/>
        <TextView
            android:textSize="28px"
            android:textColor="@color/color_ffffffff"
            android:gravity="center_vertical"
            android:id="@+id/mTvTips2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="78px"
            android:layout_marginTop="42px"
            android:layout_marginRight="78px"
            android:text="@string/adult_sure_close_tip_2"/>
        <com.zhy.autolayout.AutoLinearLayout
            android:gravity="bottom|center_horizontal"
            android:orientation="horizontal"
            android:paddingBottom="60px"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <Button
                android:id="@+id/mBtnConfirm"
                android:text="@string/dlg_ok"
                style="@style/button_double_style"/>
            <Button
                android:id="@+id/mBtnCancel"
                android:layout_marginLeft="60px"
                android:text="@string/dlg_cancel"
                style="@style/button_double_style"/>
        </com.zhy.autolayout.AutoLinearLayout>
    </com.zhy.autolayout.AutoLinearLayout>
    <com.module.view.LoadingView
        android:id="@+id/mLoadingView"
        android:visibility="gone"
        android:layout_width="180px"
        android:layout_height="180px"
        android:layout_centerInParent="true"/>
</com.zhy.autolayout.AutoRelativeLayout>
