<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="bottom|right"
    android:orientation="vertical"
    android:background="@drawable/bg_time_remain"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="19dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/mTextAuthTime"
        android:paddingLeft="21dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:text="@string/app_out_date_hint"
        android:maxLines="1"
        android:singleLine="true"
        android:drawableLeft="@drawable/icon_text_dot"
        android:drawablePadding="6dp"
        android:alpha="0.8"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <ImageView
            android:paddingTop="11dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="21dp"
            android:src="@drawable/icon_text_dot"/>
        <TextView
            android:textSize="19dp"
            android:textColor="@color/white"
            android:gravity="left"
            android:id="@+id/mTextTips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="20dp"
            android:maxWidth="669dp"
            android:text="@string/get_active_code_hint"
            android:alpha="0.8"/>
    </LinearLayout>
    <TextView
        android:textSize="19dp"
        android:textColor="@color/color_00a9fc"
        android:gravity="center"
        android:layout_gravity="right"
        android:id="@+id/mTextPressMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="20dp"
        android:text="@string/press_menu_new"
        android:alpha="0.8"/>
</LinearLayout>
