<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <View
        android:background="@color/color_c4c4c4"
        android:layout_width="320px"
        android:layout_height="6px"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="28px"
        android:textColor="@color/color_1a1a1a"
        android:gravity="center"
        android:id="@+id/tvTime"
        android:background="@drawable/shape_match_oval_bg"
        android:layout_width="70px"
        android:layout_height="70px"
        android:layout_marginLeft="10px"
        android:layout_centerVertical="true"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rlTeamA"
        android:background="@drawable/match_event_item_up_bg"
        android:focusable="false"
        android:layout_width="260px"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10px"
        android:layout_above="@+id/tvTime"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rlTeamB"
        android:background="@drawable/match_event_item_down_bg"
        android:paddingBottom="10px"
        android:focusable="false"
        android:layout_width="260px"
        android:layout_height="wrap_content"
        android:layout_marginTop="10px"
        android:layout_below="@+id/tvTime"/>
</com.zhy.autolayout.AutoRelativeLayout>
