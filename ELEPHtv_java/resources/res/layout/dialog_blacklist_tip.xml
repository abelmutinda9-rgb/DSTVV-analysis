<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.zhy.autolayout.AutoRelativeLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/bg_dialog_brasiliptv"
        android:layout_width="892px"
        android:layout_height="520px">
        <TextView
            android:textSize="40px"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/mDialogTitle"
            android:background="@drawable/dialog_title_bg"
            android:layout_width="match_parent"
            android:layout_height="80px"
            android:text="@string/account_tips"/>
        <TextView
            android:textSize="32px"
            android:textColor="@color/color_ffffffff"
            android:gravity="center"
            android:id="@+id/mContentText"
            android:paddingLeft="60px"
            android:paddingRight="60px"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/account_blacklist"
            android:layout_centerVertical="true"/>
        <com.zhy.autolayout.AutoLinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="60px"
            android:layout_alignParentBottom="true">
            <Button
                android:textSize="32px"
                android:textColor="@color/text_color"
                android:ellipsize="marquee"
                android:gravity="center"
                android:id="@+id/mBtnLogin"
                android:background="@drawable/selector_dialog_btn_account"
                android:layout_width="320px"
                android:layout_height="68px"
                android:text="@string/account_login_another"
                android:singleLine="true"
                android:textAllCaps="false"/>
            <Button
                android:textSize="32px"
                android:textColor="@color/text_color"
                android:gravity="center"
                android:id="@+id/mBtnExit"
                android:background="@drawable/selector_dialog_btn_account"
                android:layout_width="320px"
                android:layout_height="68px"
                android:layout_marginLeft="58px"
                android:text="@string/exit"
                android:textAllCaps="false"/>
        </com.zhy.autolayout.AutoLinearLayout>
    </com.zhy.autolayout.AutoRelativeLayout>
</com.zhy.autolayout.AutoLinearLayout>
