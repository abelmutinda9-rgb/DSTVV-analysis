<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="false" android:drawable="@drawable/bg_change_channel" />
    <item android:state_focused="true">
        <layer-list>
            <item android:drawable="@drawable/bg_change_channel" />
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="4.0px" android:color="@color/color_af28f3" />
                    <solid android:color="@color/transparent" />
                    <corners android:topLeftRadius="10.0px" android:topRightRadius="10.0px" android:bottomLeftRadius="10.0px" android:bottomRightRadius="10.0px" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>